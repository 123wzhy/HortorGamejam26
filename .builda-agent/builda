need_token() {
  if grant_needs_refresh; then
    refresh_grant >/dev/null 2>&1 || true
  fi
  if [ ! -f "$TOKEN_FILE" ]; then
    echo "No agent grant. Run: builda auth" >&2
    auth_recovery_hint >&2
    exit 1
  fi
}

token() { cat "$TOKEN_FILE"; }

builda_cmd() {
  if command -v builda >/dev/null 2>&1; then
    printf 'builda'
  else
    printf './%s/builda' "$ROOT"
  fi
}

auth_recovery_hint() {
  local cli
  cli="$(builda_cmd)"
  if [ -f "$REFRESH_FILE" ]; then
    echo "auth-next=retry the failed command; this CLI refreshes the short agent grant automatically when the saved agent authorization is still valid."
  else
    echo "auth-next=$cli auth"
  fi
  echo "auth-resume=after auth succeeds or refreshes, retry the command that failed."
}

# detect_engine_value 静默判定引擎（小写，与后端/协议口径一致）：
# godot 优先（有 project.godot 即 godot）；unity = ProjectSettings/ProjectVersion.txt 或
# Assets/+Packages/manifest.json；HTML5 = 根目录有 index.html 或 package.json
# （pixi/phaser/vite 等工程形态）。
detect_engine_value() {
  local root="${1:-.}"
  if [ -f "$root/project.godot" ]; then
    echo "godot"
  elif [ -f "$root/ProjectSettings/ProjectVersion.txt" ] || { [ -d "$root/Assets" ] && [ -f "$root/Packages/manifest.json" ]; }; then
    echo "unity"
  elif [ -f "$root/index.html" ] || [ -f "$root/package.json" ]; then
    echo "h5"
  else
    echo "unknown"
  fi
}

engine_detect() {
  local root="${1:-.}"
  [ -d "$root" ] || { echo "engine-detect=failed"; echo "directory not found: $root" >&2; exit 1; }
  local engine
  engine="$(detect_engine_value "$root")"
  echo "engine=$engine"
  case "$engine" in
    godot|h5|unity)
      echo "engine-upload-support=available"
      return 0
      ;;
    *)
      echo "engine-upload-support=unknown"
      echo "Project engine could not be detected. Do not upload until the user points you at a Godot, HTML5 or Unity project root." >&2
      return 1
      ;;
  esac
}

# manifest_engine 引擎单一来源：manifest 的 engine 字段优先，缺失时按目录判定，
# 非法值兜底 godot（与后端"空=godot"归一口径一致）。
manifest_engine() {
  local file="${1:-$MANIFEST}" v=""
  [ -f "$file" ] && v="$(manifest_string_field "$file" engine)"
  if [ -z "$v" ]; then
    v="$(detect_engine_value .)"
  fi
  case "$v" in
    godot|h5|unity) ;;
    *) v="godot" ;;
  esac
  printf '%s' "$v"
}

godot_web_template_check() {
  local godot_cmd="${1:-godot}"
  if ! command -v "$godot_cmd" >/dev/null 2>&1; then
    echo "godot-web-template=missing-godot-command"
    echo "Godot command not found: $godot_cmd" >&2
    echo "Install Godot, or rerun with the actual command: builda godot web-template-check godot4" >&2
    exit 1
  fi

  local version template_version template_dir
  version="$("$godot_cmd" --version 2>/dev/null | awk '{print $1}' | head -1)"
  if [ -z "$version" ]; then
    echo "godot-web-template=unknown-version"
    echo "Could not read Godot version from: $godot_cmd --version" >&2
    exit 1
  fi

  template_version="$(printf '%s' "$version" | sed 's/\.official\..*$//')"
  template_dir="$HOME/.local/share/godot/export_templates/$template_version"
  if [ -f "$template_dir/web_release.zip" ] || [ -f "$template_dir/web_nothreads_release.zip" ]; then
    echo "godot-web-template=ok"
    echo "godot-command=$godot_cmd"
    echo "godot-version=$version"
    echo "godot-template-version=$template_version"
    echo "godot-template-dir=$template_dir"
    return 0
  fi

  echo "godot-web-template=missing"
  echo "godot-command=$godot_cmd"
  echo "godot-version=$version"
  echo "godot-template-version=$template_version"
  echo "godot-template-dir=$template_dir"
  echo "Godot is installed, but Web export templates are missing for this HOME." >&2
  echo "Install matching Web export templates for Godot $version, then retry the export." >&2
  echo "If templates exist under another HOME on this machine, copy that version directory to: $template_dir" >&2
  echo "Do not zip/upload a failed or partial export; rerun bundle-check after a successful export." >&2
  exit 1
}

# Game_* commands are mandarin cmd-over-HTTP routes mounted at /game/*.
# Agent REST helpers such as upload/auth live under /api/v1/*.
cmd_url() { printf '%s/%s' "$BUILDA_BASE" "$1"; }

http_request() {
  local label="$1"
  shift
  local body_file status curl_code
  body_file="$(mktemp)"
  status="$(curl -sS -o "$body_file" -w "%{http_code}" "$@")" || {
    curl_code=$?
    echo "$label failed: curl exit $curl_code" >&2
    if [ -s "$body_file" ]; then
      echo "$label response body:" >&2
      cat "$body_file" >&2
      echo >&2
    fi
    rm -f "$body_file"
    return "$curl_code"
  }
  case "$status" in
    2??)
      cat "$body_file"
      rm -f "$body_file"
      return 0
      ;;
    *)
      echo "$label failed: HTTP $status" >&2
      echo "$label response body:" >&2
      cat "$body_file" >&2
      echo >&2
      if [ "$status" = "401" ] || [ "$status" = "403" ] || grep -q '"code"[[:space:]]*:[[:space:]]*10006' "$body_file"; then
        if [ "$label" = "Studio auth exchange" ]; then
          echo "studio-authorization-expired=1" >&2
        else
          echo "auth-required=1" >&2
          echo "Agent grant is missing or expired. Run: builda auth" >&2
          auth_recovery_hint >&2
        fi
      fi
      rm -f "$body_file"
      return 1
      ;;
  esac
}

authenticated_http_response() {
  local label="$1"
  shift
  local body_file curl_code attempt=0
  body_file="$(mktemp)"
  AUTH_HTTP_STATUS=""
  AUTH_HTTP_BODY=""
  while [ "$attempt" -lt 2 ]; do
    AUTH_HTTP_STATUS="$(curl -sS -o "$body_file" -w "%{http_code}" "$@" -H "Authorization: Bearer $(token)")" || {
      curl_code=$?
      echo "$label failed: curl exit $curl_code" >&2
      rm -f "$body_file"
      return "$curl_code"
    }
    AUTH_HTTP_BODY="$(cat "$body_file")"
    if [ "$AUTH_HTTP_STATUS" = "401" ] && [ "$attempt" -eq 0 ] && [ -f "$REFRESH_FILE" ]; then
      if refresh_grant >&2; then
        attempt=$((attempt + 1))
        continue
      fi
    fi
    if [ "$AUTH_HTTP_STATUS" = "401" ]; then
      echo "BUILDA_AUTH_REJECTED: authorization was rejected after one refresh" >&2
      rm -f "$body_file"
      return 1
    fi
    rm -f "$body_file"
    return 0
  done
  rm -f "$body_file"
  echo "BUILDA_AUTH_REJECTED: authorization was rejected after one refresh" >&2
  return 1
}

authenticated_http_request() {
  local label="$1"
  shift
  authenticated_http_response "$label" "$@" || return $?
  case "$AUTH_HTTP_STATUS" in
    2??)
      printf '%s' "$AUTH_HTTP_BODY"
      ;;
    *)
      echo "$label failed: HTTP $AUTH_HTTP_STATUS" >&2
      printf '%s\n' "$AUTH_HTTP_BODY" >&2
      if [ "$AUTH_HTTP_STATUS" = "403" ] || grep -q '"code"[[:space:]]*:[[:space:]]*10006' <<EOF
$AUTH_HTTP_BODY
EOF
      then
        echo "auth-required=1" >&2
        echo "Agent grant is missing or expired. Run: builda auth" >&2
        auth_recovery_hint >&2
      fi
      return 1
      ;;
  esac
}

json_field() {
  local name="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r ".$name // empty"
  else
    sed -n "s/.*\"$name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -1
  fi
}

json_number() {
  local name="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r ".$name // 0"
  else
    sed -n "s/.*\"$name\"[[:space:]]*:[[:space:]]*\\([0-9]*\\).*/\\1/p" | head -1
  fi
}

write_acting_identity() {
  local identity role_id user_id username account_system
  need_token
  identity="$(authenticated_http_request "whoami" "$BUILDA_BASE/api/v1/agent/whoami")"
  role_id="$(printf '%s' "$identity" | json_number roleId)"
  user_id="$(printf '%s' "$identity" | json_field userId)"
  username="$(printf '%s' "$identity" | json_field username)"
  account_system="$(printf '%s' "$identity" | json_field accountSystem)"
  echo "api-base=$BUILDA_BASE"
  echo "acting-as-role-id=$role_id"
  echo "acting-as-user-id=$user_id"
  echo "acting-as-username=$username"
  [ -n "$account_system" ] && echo "acting-as-account-system=$account_system"
  return 0
}

write_publish_preflight() {
  local action="$1" target="$2"
  write_acting_identity
  echo "action=$action"
  echo "target-game=$target"
}

validate_manifest_metadata() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import sys

contract = json.loads(r'''{"categories":["action","strategy","rolePlay","plot","adventure","sandBox","survival","pzzle","mystery","leisure","simulation","yangCheng","card","desktop","tower","rogueLike","shoot","speed","sport","fangZhi","music","dress","other","cooperation","moba","asymmetric","party","fight"],"coverKinds":["palette","image"],"engines":["godot","h5","unity"],"limits":{"descriptionBytes":600,"taglineBytes":90,"tags":5,"titleBytes":48},"orientations":["landscape","portrait"]}''')
path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if not isinstance(data, dict):
    raise SystemExit("builda.publish.json must contain a JSON object.")

def utf8_len(value):
    return len(value.encode("utf-8"))

def require_string(key, *, required=False, max_bytes=None):
    value = data.get(key)
    if not isinstance(value, str):
        raise SystemExit(f"{key} must be a string.")
    if required and not value:
        raise SystemExit(f"{key} is required.")
    if max_bytes is not None and utf8_len(value) > max_bytes:
        raise SystemExit(f"{key} must be at most {max_bytes} UTF-8 bytes.")
    return value

limits = contract["limits"]
require_string("title", required=True, max_bytes=limits["titleBytes"])
require_string("tagline", max_bytes=limits["taglineBytes"])
require_string("desc", max_bytes=limits["descriptionBytes"])

for key, contract_key in (
    ("category", "categories"),
    ("orientation", "orientations"),
    ("coverKind", "coverKinds"),
):
    value = require_string(key, required=True)
    allowed = contract[contract_key]
    if value not in allowed:
        raise SystemExit(f"{key} must be one of: {', '.join(allowed)}; got {value!r}.")

engine = data.get("engine", "")
if not isinstance(engine, str):
    raise SystemExit("engine must be a string.")
if engine and engine not in contract["engines"]:
    raise SystemExit(f"engine must be one of: {', '.join(contract['engines'])}; got {engine!r}.")

tags = data.get("tags", [])
if not isinstance(tags, list) or any(not isinstance(tag, str) for tag in tags):
    raise SystemExit("tags must be an array of strings.")
if len(tags) > limits["tags"]:
    raise SystemExit(f"tags supports at most {limits['tags']} entries.")
PY
}

normalize_manifest_category() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
category = data.get("category")
if not isinstance(category, str) or not category:
    raise SystemExit(0)
contract = json.loads(r'''{"categories":["action","strategy","rolePlay","plot","adventure","sandBox","survival","pzzle","mystery","leisure","simulation","yangCheng","card","desktop","tower","rogueLike","shoot","speed","sport","fangZhi","music","dress","other","cooperation","moba","asymmetric","party","fight"],"coverKinds":["palette","image"],"engines":["godot","h5","unity"],"limits":{"descriptionBytes":600,"taglineBytes":90,"tags":5,"titleBytes":48},"orientations":["landscape","portrait"]}''')
if category in contract["categories"]:
    raise SystemExit(0)
data["category"] = "other"
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
print(f"category={category!r} normalized to other", file=sys.stderr)
PY
}

validate_manifest_pay_points() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import re
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if "payPoints" not in data:
    raise SystemExit(0)
points = data.get("payPoints")
if not isinstance(points, list) or len(points) == 0:
    print("payPoints must be omitted for games without in-app purchases; do not send an empty array.", file=sys.stderr)
    raise SystemExit(1)
seen = set()
pay_id_re = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
for i, point in enumerate(points):
    if not isinstance(point, dict):
        print(f"payPoints[{i}] must be an object with payId/payName/price.", file=sys.stderr)
        raise SystemExit(1)
    pay_id = point.get("payId")
    pay_name = str(point.get("payName") or "").strip()
    price = point.get("price")
    if not isinstance(pay_id, str) or not pay_id_re.fullmatch(pay_id):
        print(f"payPoints[{i}].payId must be a string matching [A-Za-z0-9_-] with 1-64 bytes.", file=sys.stderr)
        raise SystemExit(1)
    if pay_id in seen:
        print(f"payPoints payId duplicated: {pay_id}", file=sys.stderr)
        raise SystemExit(1)
    seen.add(pay_id)
    if not pay_name:
        print(f"payPoints[{i}].payName is required.", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(price, int) or isinstance(price, bool):
        print(f"payPoints[{i}].price must be an integer G-coin amount.", file=sys.stderr)
        raise SystemExit(1)
    if price < 100:
        print(f"payPoints[{i}].price must be at least 100 G-coins.", file=sys.stderr)
        raise SystemExit(1)
PY
}

validate_manifest_rank_boards() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import re
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if "rankBoards" not in data:
    raise SystemExit(0)
boards = data.get("rankBoards")
if not isinstance(boards, list):
    print("rankBoards must be an array; omit it to keep existing boards or use [] to clear all boards.", file=sys.stderr)
    raise SystemExit(1)
if len(boards) > 5:
    print("rankBoards supports at most 5 boards.", file=sys.stderr)
    raise SystemExit(1)
required = {"rankId", "displayName", "sortType", "cycleType", "minScore", "maxScore"}
rank_id_re = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
score_min = -9999999999
score_max = 9999999999
seen = set()
for i, board in enumerate(boards):
    if not isinstance(board, dict):
        print(f"rankBoards[{i}] must be an object with all six fields.", file=sys.stderr)
        raise SystemExit(1)
    missing = sorted(required - set(board))
    if missing:
        print(f"rankBoards[{i}] missing required fields: {', '.join(missing)}", file=sys.stderr)
        raise SystemExit(1)
    rank_id = board["rankId"]
    display_name = board["displayName"]
    sort_type = board["sortType"]
    cycle_type = board["cycleType"]
    min_score = board["minScore"]
    max_score = board["maxScore"]
    if not isinstance(rank_id, str) or rank_id != rank_id.strip() or not rank_id_re.fullmatch(rank_id):
        print(f"rankBoards[{i}].rankId must match [A-Za-z0-9_-] and be 1-64 bytes without surrounding whitespace.", file=sys.stderr)
        raise SystemExit(1)
    if rank_id in seen:
        print(f"rankBoards rankId duplicated: {rank_id}", file=sys.stderr)
        raise SystemExit(1)
    seen.add(rank_id)
    if not isinstance(display_name, str) or display_name != display_name.strip() or not display_name or len(display_name.encode("utf-8")) > 64:
        print(f"rankBoards[{i}].displayName must be non-empty UTF-8 up to 64 bytes without surrounding whitespace.", file=sys.stderr)
        raise SystemExit(1)
    if sort_type not in {"asc", "desc"}:
        print(f"rankBoards[{i}].sortType must be asc or desc.", file=sys.stderr)
        raise SystemExit(1)
    if cycle_type not in {"day", "week", "month", "forever"}:
        print(f"rankBoards[{i}].cycleType must be day, week, month, or forever.", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(min_score, int) or isinstance(min_score, bool) or not isinstance(max_score, int) or isinstance(max_score, bool):
        print(f"rankBoards[{i}].minScore and maxScore must be integers.", file=sys.stderr)
        raise SystemExit(1)
    if min_score < score_min or max_score > score_max or min_score > max_score:
        print(f"rankBoards[{i}] score bounds must be ordered and within the supported range [-9999999999, 9999999999].", file=sys.stderr)
        raise SystemExit(1)
PY
}

validate_manifest_browser_minimums() {
  local file="$1"
  [ -f "$file" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
ok = True
for key in ("minChromeMajor", "minIOSMajor"):
    value = data.get(key)
