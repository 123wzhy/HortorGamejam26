  grep -qF "$begin" AGENTS.md || return 1
  awk -v b="$begin" -v e="$end" '
    index($0, b) {skip=1; next}
    index($0, e) {skip=0; next}
    !skip {print}
  ' AGENTS.md > AGENTS.md.builda-tmp && mv AGENTS.md.builda-tmp AGENTS.md
}

write_agents_md_block() {
