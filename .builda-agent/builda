sdk_check() {
  local engine
  engine="$(detect_engine_value .)"
  if [ "$engine" = "h5" ]; then
    sdk_check_web
    return
  fi
  if [ "$engine" = "unity" ]; then
    sdk_check_unity
    return
  fi
  [ -f addons/builda/builda.gd ] || { echo "Missing addons/builda/builda.gd. Run: builda sdk install" >&2; return 1; }
  [ -f addons/builda/web/builda-sdk.js ] || { echo "Missing addons/builda/web/builda-sdk.js. Run: builda sdk install" >&2; return 1; }
  [ -f addons/builda/web/builda-sdk.d.ts ] || { echo "Missing addons/builda/web/builda-sdk.d.ts. Run: builda sdk install" >&2; return 1; }
  local sdk_version plugin_version
  if [ -f "$SDK_VERSION_FILE" ]; then
    sdk_version="$(head -n 1 "$SDK_VERSION_FILE" | tr -d '\r')"
    echo "sdk-version=$sdk_version"
  else
    echo "sdk-version=unknown"
    echo "sdk-upgrade-hint=run builda sdk install to record the installed SDK version"
  fi
  plugin_version="$(sed -n 's/^version="\([^"]*\)".*/\1/p' addons/builda/plugin.cfg 2>/dev/null | head -n 1)"
  if [ -n "$plugin_version" ]; then
    echo "sdk-addon-version=$plugin_version"
    if [ -n "${sdk_version:-}" ] && [ "$plugin_version" != "$sdk_version" ]; then
      echo "SDK version mismatch: $SDK_VERSION_FILE=$sdk_version but addons/builda/plugin.cfg=$plugin_version. Run: builda sdk install" >&2
      return 1
    fi
  else
    echo "sdk-addon-version=unknown"
  fi
  if [ -f project.godot ] && grep -Eq '^BuildaClient="\*res://scripts/BuildaClient\.gd"' project.godot && [ ! -f scripts/BuildaClient.gd ]; then
    echo "Autoload BuildaClient points to missing scripts/BuildaClient.gd. Run: builda sdk install" >&2
    return 1
  fi
  if [ -f scripts/BuildaClient.gd ]; then
    echo "sdk-client=scripts/BuildaClient.gd user-owned"
  else
    echo "sdk-client=missing"
  fi
  if ! sdk_compat_check; then
    return 1
  fi
  echo "sdk=ok"
  echo "sdk-addon=addons/builda"
}

