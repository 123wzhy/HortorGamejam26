}

open_authorize_url() {
  local url="$1"
  if [ -n "${BROWSER:-}" ]; then
    "$BROWSER" "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 &
  else
    return 1
  fi
}

save_grant() {
  local grant="$1"
  [ -n "$grant" ] || { echo "empty grant" >&2; exit 1; }
  mkdir -p "$AUTH_DIR"
  printf '%s' "$grant" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  echo "Agent grant saved for 30 minutes."
}

save_refresh() {
  local refresh="$1"
  [ -n "$refresh" ] || return 0
  mkdir -p "$AUTH_DIR"
  printf '%s' "$refresh" > "$REFRESH_FILE"
  chmod 600 "$REFRESH_FILE"
  echo "Agent authorization saved for 30 days."
}

grant_needs_refresh() {
  [ -f "$REFRESH_FILE" ] || return 1
  [ -f "$TOKEN_FILE" ] || return 0
  local now mtime age
  now="$(date +%s)"
  if mtime="$(stat -c %Y "$TOKEN_FILE" 2>/dev/null)"; then
    :
  elif mtime="$(stat -f %m "$TOKEN_FILE" 2>/dev/null)"; then
    :
  else
    return 1
  fi
  age=$((now - mtime))
  [ "$age" -ge 1500 ]
}

grant_is_fresh() {
  [ -f "$TOKEN_FILE" ] || return 1
  local now mtime age
  now="$(date +%s)"
  if mtime="$(stat -c %Y "$TOKEN_FILE" 2>/dev/null)"; then
    :
  elif mtime="$(stat -f %m "$TOKEN_FILE" 2>/dev/null)"; then
    :
  else
    return 1
  fi
  age=$((now - mtime))
  [ "$age" -lt 1500 ]
}

refresh_grant() {
  [ -f "$REFRESH_FILE" ] || return 1
  local refresh resp grant
  refresh="$(cat "$REFRESH_FILE")"
  [ -n "$refresh" ] || return 1
  resp="$(curl -sS -X POST "$BUILDA_BASE/api/v1/agent/auth/refresh" -H 'Content-Type: application/json' -d "{\"refresh_token\":\"$refresh\"}")" || return 1
  grant="$(printf '%s' "$resp" | json_field token)"
  [ -n "$grant" ] || return 1
  save_grant "$grant" >/dev/null
  echo "Agent grant refreshed automatically."
}

auth_with_pair_code() {
  local code="$1"
  resp="$(curl -sS -X POST "$BUILDA_BASE/api/v1/agent/exchange" -H 'Content-Type: application/json' -d "{\"code\":\"$code\"}")"
  grant="$(printf '%s' "$resp" | json_field token)"
  if [ -z "$grant" ]; then
    echo "Pair code exchange failed or expired. Starting browser authorization instead." >&2
    auth_with_browser
    return
  fi
  save_grant "$grant"
  save_refresh "$(printf '%s' "$resp" | json_field refresh_token)"
}

auth_with_browser() {
  auth_start_body='{}'
  if [ -n "$BUILDA_SITE_ORIGIN" ]; then
    auth_start_body="$(printf '{\"site_origin\":\"%s\"}' "$BUILDA_SITE_ORIGIN")"
  fi
  resp="$(http_request "auth start" -X POST "$BUILDA_BASE/api/v1/agent/auth/start" -H 'Content-Type: application/json' -d "$auth_start_body")"
  auth_id="$(printf '%s' "$resp" | json_field auth_id)"
  authorize_url="$(printf '%s' "$resp" | json_field authorize_url)"
  activate_url="$(printf '%s' "$resp" | json_field activate_url)"
  user_code="$(printf '%s' "$resp" | json_field user_code)"
  interval="$(printf '%s' "$resp" | json_number interval)"
  expires="$(printf '%s' "$resp" | json_number expires_in)"
  [ -n "$auth_id" ] && [ -n "$authorize_url" ] || { echo "Auth start failed: $resp" >&2; exit 1; }
  activate_url="${activate_url:-$BUILDA_BASE/activate}"
  interval="${interval:-2}"
  expires="${expires:-600}"

  echo "I need your BuildaGame permission to upload a draft."
  echo "Opening the browser authorization page..."
  if ! open_authorize_url "$authorize_url"; then
    echo "Open this URL in your browser:"
    echo "$authorize_url"
  else
    echo "If the browser did not open, visit:"
    echo "$authorize_url"
  fi
  if [ -n "$user_code" ]; then
    echo
    echo "On another device, open:"
    echo "$activate_url"
    echo "Enter code: $user_code"
  fi
  echo "Log in or sign up there, click Allow agent, then return here."

  elapsed=0
  while [ "$elapsed" -lt "$expires" ]; do
    sleep "$interval"
    elapsed=$((elapsed + interval))
    poll="$(http_request "auth status" "$BUILDA_BASE/api/v1/agent/auth/status?auth_id=$auth_id")"
    status="$(printf '%s' "$poll" | json_field status)"
    case "$status" in
      approved)
        grant="$(printf '%s' "$poll" | json_field token)"
        save_grant "$grant"
        save_refresh "$(printf '%s' "$poll" | json_field refresh_token)"
        return
        ;;
      expired)
        echo "Authorization expired. Run: builda auth" >&2
        exit 1
        ;;
      pending|"")
        printf '.'
        ;;
      *)
        echo "Authorization failed: $poll" >&2
        exit 1
        ;;
    esac
  done
  echo
  echo "Authorization timed out. Run: builda auth" >&2
  exit 1
}

ensure_authorization() {
  local code="${1:-}"
  if [ -f "$TOKEN_FILE" ] && authenticated_http_request "whoami" "$BUILDA_BASE/api/v1/agent/whoami" >/dev/null 2>&1; then
    echo "authorization=ready"
    echo "grant=present"
    [ -f "$REFRESH_FILE" ] && echo "agent-authorization=present" || echo "agent-authorization=missing"
    return
  fi
  if [ ! -f "$TOKEN_FILE" ] && [ -f "$REFRESH_FILE" ] && refresh_grant; then
    echo "authorization=ready"
    echo "grant=present"
    echo "agent-authorization=present"
    return
  fi
  if [ -n "$code" ]; then
    auth_with_pair_code "$code"
  else
    auth_with_browser
  fi
  echo "authorization=ready"
  echo "grant=present"
  [ -f "$REFRESH_FILE" ] && echo "agent-authorization=present" || echo "agent-authorization=missing"
}

studio_auth() {
  ticket="${BUILDA_STUDIO_AUTH_TICKET:-}"
  [ -n "$ticket" ] || { echo "studio-auth requires BUILDA_STUDIO_AUTH_TICKET" >&2; exit 1; }
  umask 077
  mkdir -p "$AUTH_DIR"
  chmod 700 "$AUTH_DIR"
  [ -w "$AUTH_DIR" ] || { echo "studio-auth cannot write the auth directory" >&2; exit 1; }
  [ ! -f "$REFRESH_FILE" ] || {
    echo "studio-auth refuses an auth directory containing a refresh-token; use an isolated Studio HOME" >&2
    exit 1
  }
  resp="$(printf '{\"ticket\":\"%s\"}' "$ticket" | http_request "Studio auth exchange" -X POST "$BUILDA_BASE/api/v1/agent/auth/studio-exchange" -H 'Content-Type: application/json' --data-binary @-)"
  grant="$(printf '%s' "$resp" | json_field token)"
  [ -n "$grant" ] || { echo "Studio auth exchange did not return a grant." >&2; exit 1; }
  refresh="$(printf '%s' "$resp" | json_field refresh_token)"
  [ -n "$refresh" ] || { echo "Studio auth exchange did not return a renewal credential." >&2; exit 1; }
  save_grant "$grant" >/dev/null
  save_refresh "$refresh" >/dev/null
  echo "authorization=ready"
  echo "grant=present"
  echo "agent-authorization=present"
  echo "authorization-source=studio"
}

original_args=("$@")
cmd="${1:-}"
shift || true
case "$cmd" in
  ""|-h|--help|help|version|--version|-v) ;; # 这些命令不依赖项目上下文
  *) require_project_context "${original_args[@]}" ;;
esac
legacy_auth_migrate
[ "$cmd" = "studio-auth" ] || maybe_self_update "${original_args[@]}"
case "$cmd" in
  studio-auth)
    studio_auth
    ;;
  auth)
    auth_arg="${1:-}"
    if [ "$auth_arg" = "--force" ]; then
      auth_with_browser
      echo "authorization=ready"
      echo "grant=present"
      echo "agent-authorization=present"
    else
      code="${auth_arg:-${BUILDA_PAIR_CODE:-}}"
      ensure_authorization "$code"
    fi
    ;;
  whoami)
    write_acting_identity
    ;;
  check)
    check_update
    sync_project_registrations >/dev/null
    echo "project-registrations=ensured"
    echo "BUILDA_BASE=$BUILDA_BASE"
    echo "BUILDA_AGENT_BASE=$BUILDA_AGENT_BASE"
    [ -f "$TOKEN_FILE" ] && echo "grant=present" || echo "grant=missing"
    [ -f "$REFRESH_FILE" ] && echo "agent-authorization=present" || echo "agent-authorization=missing"
    command -v curl >/dev/null 2>&1 && echo "curl=ok" || echo "curl=missing"
    command -v jq >/dev/null 2>&1 && echo "jq=ok" || echo "jq=missing (optional; receipts still print)"
    echo "engine=$(detect_engine_value .)"
    if [ -f "$PROJECT_FILE" ]; then
      pgid="$(project_game_id)"
      [ -n "$pgid" ] && echo "project-game-id=$pgid" || echo "project-game-id=invalid"
      echo "project-state-dir=$(dirname "$PROJECT_FILE")"
    elif [ -f "$LEGACY_PROJECT_FILE" ]; then
      pgid="$(project_game_id)"
      [ -n "$pgid" ] && echo "project-game-id=$pgid" || echo "project-game-id=invalid"
      echo "project-binding=$PROJECT_FILE"
      echo "project-state-dir=$(dirname "$PROJECT_FILE")"
    else
      echo "project-game-id=missing"
    fi
    ;;
  update)
    self_update "$(remote_version)"
    ;;
  sync-project)
    echo "Agent registrations:"
    sync_project_registrations
    ;;
  engine)
    sub="${1:-}"
    shift || true
    case "$sub" in
      detect)
        engine_detect "${1:-.}"
        ;;
      ""|-h|--help|help)
        echo "Usage: builda engine detect [dir]"
        ;;
      *)
        echo "Unknown engine command: $sub" >&2
        echo "Usage: builda engine detect [dir]" >&2
        exit 1
        ;;
    esac
    ;;
  version|--version|-v)
    echo "$VERSION"
    ;;
  new-manifest)
    if [ -f "$MANIFEST" ]; then echo "$MANIFEST already exists"; exit 0; fi
    # engine 按目录判定写入 manifest（后续 bundle-check/upload-build 以 manifest 为准）；
    # unknown 兜底 godot，与后端"空=godot"口径一致
    detected_engine="$(detect_engine_value .)"
    case "$detected_engine" in
      godot|h5|unity) ;;
      *) detected_engine="godot" ;;
    esac
    cat > "$MANIFEST" <<JSON
{
  "title": "Your game",
  "tagline": "One short sentence about the game.",
  "desc": "What players should know before playing.",
  "category": "",
  "engine": "$detected_engine",
  "tags": ["$detected_engine"],
  "orientation": "landscape",
  "minChromeMajor": 0,
  "minIOSMajor": 0,
  "coverKind": "palette",
  "coverPalette": "ember",
  "coverUrl": "",
  "buildPrefix": "",
  "buildEntry": "index.html",
  "buildSize": 0,
  "bundleUrl": "",
  "bundleMd5": "",
  "bundleVersion": "",
  "bundleEntry": "index.html",
  "bundleSize": 0,
  "assetsVersion": "",
  "assetsBaseUrl": "",
  "assetsManifestUrl": "",
  "sdkVersion": ""
}
JSON
    echo "For in-app purchases, add payPoints only when needed, for example:"
    echo '  "payPoints": [{"payId":"coin_pack_1","payName":"Coins Pack","price":100}]'
    echo "Omit payPoints entirely for games without purchases; do not write an empty array."
    echo "For leaderboards, omit rankBoards to keep existing boards; use [] only to clear all boards."
    echo '  "rankBoards": [{"rankId":"high_score","displayName":"High Score","sortType":"desc","cycleType":"forever","minScore":0,"maxScore":9999999999}]'
    echo "category is required: choose exactly one of the 28 values documented in .builda-agent/SKILL.md; do not invent a value or change its case."
    echo "minChromeMajor/minIOSMajor gate which devices may play: fill the LOWEST browser majors the build actually runs on (lower = more players; the 0 placeholders are rejected until you assess and fill them)."
    echo "Judge by what the build really requires: WASM engine exports (e.g. Godot 4 Web, Unity WebGL) inherit their floor from the compiler toolchain (post-MVP WASM features land around Chrome 75-85 / iOS 15) - check the engine or Emscripten minimum-browser docs, and fall back to the platform baseline 80/15 when you cannot verify lower; plain canvas/DOM H5 with down-leveled JS can go much lower. Do not inflate the values, and do not claim majors the build cannot actually run on."
    echo "Wrote $MANIFEST"
    ;;
  dev)
    builda_dev_parse "$@"
    ;;
  godot)
    sub="${1:-}"
    shift || true
    case "$sub" in
      web-template-check)
        godot_web_template_check "${1:-godot}"
        ;;
      ""|-h|--help|help)
        echo "Usage: builda godot web-template-check [godot|godot4]"
        ;;
      *)
        echo "Unknown godot command: $sub" >&2
        echo "Usage: builda godot web-template-check [godot|godot4]" >&2
        exit 1
        ;;
    esac
    ;;
  sdk)
    sub="${1:-}"
    shift || true
    case "$sub" in
      init)
        sdk_init
        ;;
      install)
        sdk_install
        ;;
      check)
        sdk_check
        ;;
      smoke)
        sdk_smoke
        ;;
      ""|-h|--help|help)
        echo "Usage: builda sdk init | install | check | smoke"
        ;;
      *)
        echo "Unknown sdk command: $sub" >&2
        echo "Usage: builda sdk init | install | check | smoke" >&2
        exit 1
        ;;
    esac
    ;;
  bundle-check)
    bundle_check "$@"
    ;;
  assets)
    sub="${1:-}"
    shift || true
    case "$sub" in
      check)
        assets_check_zip "${1:-}"
        ;;
      upload)
        assets_upload "${1:-}"
        ;;
      ""|-h|--help|help)
        echo "Usage: builda assets check <zip> | upload <zip>"
        ;;
      *)
        echo "Unknown assets command: $sub" >&2
        echo "Usage: builda assets check <zip> | upload <zip>" >&2
        exit 1
        ;;
    esac
    ;;
  upload-build)
    need_token
    zip="${1:-}"
    engine="$(manifest_engine "$MANIFEST")"
    bundle_check --engine "$engine" "$zip" >/dev/null
    identity="$(bundle_identity "$zip" "$engine")"
    expected_size="$(printf '%s\n' "$identity" | sed -n '1p')"
    expected_sha="$(printf '%s\n' "$identity" | sed -n '2p')"
    studio_payload_hash=""
    if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
      studio_payload_hash="$(printf '%s\n' "$identity" | sed -n '3p')"
    fi
    game_id="$(project_game_id)"
    idempotency="${BUILDA_PUBLISH_OPERATION_ID:-$(upload_idempotency_key "$engine" "$game_id" "$expected_sha")}"
    resp="$(run_session_upload "$zip" "$engine" "$game_id" "$expected_size" "$expected_sha" "$idempotency" "$studio_payload_hash")"
    printf '%s\n' "$resp" > "$ROOT/last-build.json"
    prefix="$(printf '%s' "$resp" | json_field prefix)"
    entry="$(printf '%s' "$resp" | json_field entry)"
    size="$(printf '%s' "$resp" | json_number size)"
    bundle_url="$(printf '%s' "$resp" | json_field bundleUrl)"
    bundle_md5="$(printf '%s' "$resp" | json_field bundleMd5)"
    bundle_version="$(printf '%s' "$resp" | json_field bundleVersion)"
    bundle_entry="$(printf '%s' "$resp" | json_field bundleEntry)"
    bundle_size="$(printf '%s' "$resp" | json_number bundleSize)"
    echo "$resp"
    if [ -n "$prefix" ]; then
      if [ ! -f "$MANIFEST" ]; then "$0" new-manifest >/dev/null; fi
      update_manifest_build_fields "$MANIFEST" "$resp"
      echo "Updated $MANIFEST with build and H5 Bundle fields."
    fi
    ;;
  upload-status)
    need_token
    query_upload_session "${1:-}"
    ;;
  upload-cancel)
    need_token
    cancel_upload_session "${1:-}"
    ;;
  publish)
    zip="${1:-}"
    file="${2:-$MANIFEST}"
    case "$zip" in
      -h|--help|help)
        echo "Usage: builda publish [build.zip] [manifest]"
        exit 0
        ;;
    esac
    [ -f "$file" ] || { echo "manifest not found: $file" >&2; exit 1; }
    sync_online_compatibility_revision "$file"
    preflight_manifest_for_draft "$file"
    if [ -n "$zip" ]; then
      [ -f "$zip" ] || { echo "build zip not found: $zip" >&2; exit 1; }
      BUILDA_MANIFEST="$file" "$0" upload-build "$zip"
    fi
    inject_sdk_version "$file"
    pending_create=""
    if [ -z "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
      pending_create="$(draft_idempotency_key create "" "$file" 1)"
    fi
    if [ -n "$pending_create" ]; then
      "$0" create-draft "$file"
    elif [ -n "$(project_game_id)" ]; then
      "$0" update-draft "" "$file"
    else
      "$0" create-draft "$file"
    fi
    ;;
  create-draft)
    file="${1:-$MANIFEST}"
    case "$file" in
      -h|--help|help)
        echo "Usage: builda create-draft [manifest]"
        exit 0
        ;;
    esac
    [ -f "$file" ] || { echo "manifest not found: $file" >&2; exit 1; }
    sync_online_compatibility_revision "$file"
    preflight_manifest_for_draft "$file"
    inject_sdk_version "$file"
    need_token
    write_publish_preflight create-draft new >&2
    migrate_legacy_project_file
    operation_id=""
    if [ -z "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
      operation_id="$(draft_idempotency_key create "" "$file" 1)"
    fi
    if [ -f "$PROJECT_FILE" ]; then
      existing_id="$(project_game_id)"
      if [ -n "$existing_id" ] && [ -z "$operation_id" ]; then
        echo "$PROJECT_FILE already binds this project to $existing_id. Use: builda update-draft" >&2
        exit 1
      fi
    fi
    if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
      resp="$(authenticated_http_request "create draft" -X POST "$(cmd_url game/create)" -H "Idempotency-Key: $BUILDA_PUBLISH_OPERATION_ID" -H "X-Builda-Studio-Publish-Id: $BUILDA_PUBLISH_OPERATION_ID" -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}" -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}" -H 'Content-Type: application/json' --data-binary "@$file")"
    else
      [ -n "$operation_id" ] || operation_id="$(draft_idempotency_key create "" "$file")"
      resp="$(authenticated_http_request "create draft" -X POST "$(cmd_url game/create)" -H "Idempotency-Key: $operation_id" -H 'Content-Type: application/json' --data-binary "@$file")"
    fi
    cmd_response_ok_or_exit "create draft" "$resp"
    printf '%s\n' "$resp" > "$ROOT/last-draft.json"
    game_id="$(printf '%s' "$resp" | { if command -v jq >/dev/null 2>&1; then jq -r '.body.game.id // empty'; else sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' | head -1; fi; })"
    version_id="$(printf '%s' "$resp" | { if command -v jq >/dev/null 2>&1; then jq -r '.body.game.versionId // .body.game.draftVersionId // empty'; else sed -n 's/.*"versionId"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' | head -1; fi; })"
    title="$(manifest_title "$file")"
    [ -n "$game_id" ] && printf '%s' "$game_id" > "$ROOT/last-game-id"
    [ -n "$game_id" ] && printf '%s' "$game_id" > "$ROOT/last-draft-id"
    [ -n "$version_id" ] && printf '%s' "$version_id" > "$ROOT/last-version-id"
    write_project_game "$game_id" "$title" "$version_id"
    [ -n "${operation_id:-}" ] && complete_draft_operation "$operation_id"
    echo "sync=ok builda-current-version=$version_id builda-stage=pending-app-publish" >&2
    echo "$resp"
    ;;
  update-draft)
    id="${1:-}"
    case "$id" in
      -h|--help|help)
        echo "Usage: builda update-draft [game_id] [manifest]"
        exit 0
        ;;
    esac
    file="${2:-$MANIFEST}"
    if [ -n "$id" ] && [ -f "$id" ]; then file="$id"; id=""; fi
    if [ -z "$id" ]; then id="$(project_game_id)"; fi
    if [ -z "$id" ] && [ -f "$ROOT/last-game-id" ]; then
      weak_id="$(cat "$ROOT/last-game-id")"
      echo "No $PROJECT_FILE in this project. Found receipt last-game-id=$weak_id in $ROOT (weak recovery hint from an earlier draft in this project)." >&2
      echo "Pass the intended id explicitly once: builda update-draft $weak_id" >&2
      exit 1
    fi
    [ -n "$id" ] || { echo "game id required. Put $PROJECT_STATE_DIR/game.json in this project or pass game id explicitly." >&2; exit 1; }
    [ -f "$file" ] || { echo "manifest not found: $file" >&2; exit 1; }
    sync_online_compatibility_revision "$file"
    preflight_manifest_for_draft "$file"
    inject_sdk_version "$file"
    need_token
    write_publish_preflight update-draft "$id" >&2
    tmp="$(mktemp)"
    if command -v jq >/dev/null 2>&1; then
      jq --arg id "$id" '.id=$id' "$file" > "$tmp"
    elif command -v python3 >/dev/null 2>&1; then
      python3 - "$file" "$id" > "$tmp" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
data["id"] = sys.argv[2]
json.dump(data, sys.stdout, ensure_ascii=False, separators=(",", ":"))
PY
    else
      echo "update-draft requires jq or python3 to merge game id into the manifest safely." >&2
      exit 1
    fi
    if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
      resp="$(authenticated_http_request "update draft" -X POST "$(cmd_url game/updatedraft)" -H "Idempotency-Key: $BUILDA_PUBLISH_OPERATION_ID" -H "X-Builda-Studio-Publish-Id: $BUILDA_PUBLISH_OPERATION_ID" -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}" -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}" -H 'Content-Type: application/json' --data-binary "@$tmp")"
    else
      operation_id="$(draft_idempotency_key update "$id" "$file")"
      resp="$(authenticated_http_request "update draft" -X POST "$(cmd_url game/updatedraft)" -H "Idempotency-Key: $operation_id" -H 'Content-Type: application/json' --data-binary "@$tmp")"
    fi
    rm -f "$tmp"
    cmd_response_ok_or_exit "update draft" "$resp"
    printf '%s\n' "$resp" > "$ROOT/last-draft.json"
    game_id="$(printf '%s' "$resp" | { if command -v jq >/dev/null 2>&1; then jq -r '.body.game.id // empty'; else sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' | head -1; fi; })"
    version_id="$(printf '%s' "$resp" | { if command -v jq >/dev/null 2>&1; then jq -r '.body.game.versionId // .body.game.draftVersionId // empty'; else sed -n 's/.*"versionId"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' | head -1; fi; })"
    [ -n "$game_id" ] || game_id="$id"
    title="$(manifest_title "$file")"
    [ -n "$game_id" ] && printf '%s' "$game_id" > "$ROOT/last-game-id"
    [ -n "$game_id" ] && printf '%s' "$game_id" > "$ROOT/last-draft-id"
    [ -n "$version_id" ] && printf '%s' "$version_id" > "$ROOT/last-version-id"
    write_project_game "$game_id" "$title" "$version_id"
    [ -n "${operation_id:-}" ] && complete_draft_operation "$operation_id"
    echo "sync=ok builda-current-version=$version_id builda-stage=pending-app-publish" >&2
    echo "$resp"
    ;;
	  status)
    echo "root=$ROOT"
    [ -f "$TOKEN_FILE" ] && echo "grant=present" || echo "grant=missing"
    [ -f "$REFRESH_FILE" ] && echo "agent-authorization=present" || echo "agent-authorization=missing"
    if [ -f "$TOKEN_FILE" ]; then
      if ! write_acting_identity; then
        echo "identity=unavailable"
      fi
    else
      echo "identity=unavailable"
    fi
    [ -f "$MANIFEST" ] && echo "manifest=$MANIFEST"
    if [ -f "$PROJECT_FILE" ]; then
      pgid="$(project_game_id)"
      [ -n "$pgid" ] && echo "project-game-id=$pgid" || echo "project-game-id=invalid"
      echo "project-binding=$PROJECT_FILE"
      echo "project-state-dir=$(dirname "$PROJECT_FILE")"
    fi
    [ -f "$ROOT/last-build.json" ] && echo "last-build=$ROOT/last-build.json"
    [ -f "$ROOT/last-assets.json" ] && echo "last-assets=$ROOT/last-assets.json"
    [ -f "$ROOT/last-game-id" ] && echo "last-game-id=$(cat "$ROOT/last-game-id") (project-local receipt; game.json is the identity)"
    [ -f "$ROOT/last-version-id" ] && echo "last-version-id=$(cat "$ROOT/last-version-id")"
	    true
	    ;;
	  uninstall)
	    uninstall_builda "${1:-}"
	    ;;
	  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
esac
