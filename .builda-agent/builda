if not ok:
    raise SystemExit(1)
PY
}

inject_sdk_version() {
  # sdkVersion 跟随项目 SDK 安装收据（sdk install 写入），草稿上报后进 release manifest 的
  # sdk 契约，宿主按它下载 runtime SDK；不要手工维护该字段。
  local file="$1" v tmp
  [ -f "$SDK_VERSION_FILE" ] || return 0
  v="$(head -n 1 "$SDK_VERSION_FILE" | tr -d '\r')"
  [ -n "$v" ] || return 0
  tmp="$(mktemp)"
  if command -v jq >/dev/null 2>&1; then
    if jq --arg v "$v" '.sdkVersion=$v' "$file" > "$tmp" 2>/dev/null; then mv "$tmp" "$file"; else rm -f "$tmp"; fi
  elif command -v python3 >/dev/null 2>&1; then
    if python3 - "$file" "$v" > "$tmp" 2>/dev/null <<'PYSDK'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
data["sdkVersion"] = sys.argv[2]
json.dump(data, sys.stdout, ensure_ascii=False, separators=(",", ":"))
PYSDK
    then mv "$tmp" "$file"; else rm -f "$tmp"; fi
  else
    rm -f "$tmp"
  fi
}

preflight_manifest_for_draft() {
  local file="$1"
  if ! normalize_manifest_category "$file"; then
    echo "draft-preflight=failed" >&2
    echo "Unable to normalize category in $file." >&2
    exit 1
  fi
  if ! validate_manifest_metadata "$file"; then
    echo "draft-preflight=failed" >&2
    echo "Fix the publish metadata in $file using the exact allowed values printed above, then rerun this command." >&2
    exit 1
  fi
  if ! validate_manifest_pay_points "$file"; then
    echo "draft-preflight=failed" >&2
    echo "Fix payPoints in $file. Use payPoints only for in-app purchases: [{\"payId\":\"coin_pack_1\",\"payName\":\"Coins Pack\",\"price\":100}]. Omit the field for games without purchases." >&2
    exit 1
  fi
  if ! validate_manifest_rank_boards "$file"; then
    echo "draft-preflight=failed" >&2
    echo "Fix rankBoards in $file. Omit it to keep existing boards, use [] to clear all boards, or provide the complete target array." >&2
    exit 1
  fi
  if ! validate_manifest_browser_minimums "$file"; then
    echo "draft-preflight=failed" >&2
    echo "Fill minChromeMajor and minIOSMajor in $file as positive integers: the LOWEST Chrome major and Safari iOS major this build actually runs on. Lower values let more devices play, so do not inflate them; but ground the floor in evidence: WASM engine exports (e.g. Godot 4 Web) inherit it from the compiler toolchain (post-MVP WASM features land around Chrome 75-85 / iOS 15; check engine or Emscripten minimum-browser docs, fall back to the platform baseline 80/15 when unverifiable), while plain canvas/DOM H5 with down-leveled JS can go much lower. Then rerun this command." >&2
    exit 1
  fi
}

sync_online_compatibility_revision() {
  local file="$1" online="builda.online.json" revision tmp
  [ -f "$online" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    revision="$(jq -er '.onlineCompatibilityRevision | select(type == "number" and floor == . and . > 0)' "$online" 2>/dev/null)" || {
      echo "builda.online.json onlineCompatibilityRevision must be a positive integer" >&2
      exit 1
    }
    tmp="$(mktemp)"
    jq --argjson revision "$revision" '.onlineCompatibilityRevision=$revision' "$file" > "$tmp" && mv "$tmp" "$file"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$online" "$file" <<'PYREV'
import json, sys
online_path, manifest_path = sys.argv[1:]
with open(online_path, encoding="utf-8") as f:
    revision = json.load(f).get("onlineCompatibilityRevision")
if isinstance(revision, bool) or not isinstance(revision, int) or revision <= 0:
    raise SystemExit("builda.online.json onlineCompatibilityRevision must be a positive integer")
with open(manifest_path, encoding="utf-8") as f:
    manifest = json.load(f)
manifest["onlineCompatibilityRevision"] = revision
with open(manifest_path, "w", encoding="utf-8") as f:
    json.dump(manifest, f, ensure_ascii=False, separators=(",", ":"))
PYREV
  else
    echo "Syncing onlineCompatibilityRevision requires jq or python3" >&2
    exit 1
  fi
}

sdk_compat_check() {
  [ -d . ] || return 0
  command -v python3 >/dev/null 2>&1 || { echo "sdk-compat=skipped python3 missing"; return 0; }
  python3 - <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(".").resolve()
include_suffixes = {".gd", ".js", ".ts", ".tsx", ".jsx", ".html", ".cfg", ".tscn"}
# Unity 工程目录整体跳过：旧 Builda SDK API 只存在于 GDScript/JS 时代，Unity 项目无迁移
# 负担；Library/Temp 文件量大，扫描徒增耗时与误报面。
skip_parts = {
    ".git", ".godot", ".builda-agent", ".builda-godot-agent", "addons", "node_modules",
    "__pycache__", "build", "dist", "target", "server-pack", "server_pack",
    "Library", "Temp", "Obj", "Logs", "Assets", "ProjectSettings", "Packages",
}
patterns = [
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*cloud_get\s*\("), "replace old cloud_get(...) with private_kv_get(...)"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*cloud_set\s*\("), "replace old cloud_set(...) with private_kv_set(...)"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*cloud_delete\s*\("), "replace old cloud_delete(...) with private_kv_remove(...)"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*kv_get\s*\("), "kv_get(...) no longer exists; use private_kv_get(...) (value is now bytes: var_to_bytes/bytes_to_var)"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*kv_set\s*\("), "kv_set(...) no longer exists; use private_kv_set(key, var_to_bytes(...))"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*kv_remove\s*\("), "kv_remove(...) no longer exists; use private_kv_remove(...)"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*kv\s*\."), "Builda.kv.* no longer exists; use Builda.privateKV.* (value is now Uint8Array)"),
    (re.compile(r"Engine\.get_singleton\s*\(\s*[\"']Builda[\"']\s*\)"), "replace old Engine.get_singleton(\"Builda\") usage with the generated BuildaClient autoload"),
    (re.compile(r"get_node(?:_or_null)?\s*\(\s*[\"']/root/Builda[\"']\s*\)"), "replace old /root/Builda node usage with /root/BuildaClient"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*init\s*\("), "old Builda.init(...) is no longer part of the public SDK; use BuildaClient.builda.runtime_ready() when the game is ready"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*event\s*\("), "old event(...) analytics API is not part of the MVP SDK; remove it or keep analytics outside Builda"),
    (re.compile(r"\b(?:Builda|builda)\s*\.\s*track\s*\("), "old track(...) analytics API is not part of the MVP SDK; remove it or keep analytics outside Builda"),
    (re.compile(r"\bbackend_create\s*\("), "backend_create(...) 当前不受支持；联机功能内测中，如有需求请联系 Builda 官方"),
    (re.compile(r"\bBuilda\s*\.\s*backend\s*\.\s*create\s*\("), "Builda.backend.create() 当前不受支持；联机功能内测中，如有需求请联系 Builda 官方"),
]
errors = []

def strip_comment_only(line, suffix, in_block):
    """Remove comment-only text while retaining any code after a block comment."""
    code = line.lstrip()
    block_markers = [("/*", "*/")]
    if suffix == ".html":
        block_markers.insert(0, ("<!--", "-->"))
    if in_block:
        end = code.find(in_block)
        if end < 0:
            return "", in_block
        code = code[end + len(in_block):].lstrip()
        in_block = ""
    while code:
        matched = False
        for start, end_marker in block_markers:
            if code.startswith(start):
                end = code.find(end_marker, len(start))
                if end < 0:
                    return "", end_marker
                code = code[end + len(end_marker):].lstrip()
                matched = True
                break
        if not matched:
            break
    # comment-only lines are documentation, not executable legacy SDK calls.
    if code.startswith("//") or code.startswith("#") or code.startswith(";"):
        return "", in_block
    return code, in_block

for path in root.rglob("*"):
    if not path.is_file() or path.suffix.lower() not in include_suffixes:
        continue
    rel = path.relative_to(root)
    if any(part in skip_parts for part in rel.parts):
        continue
    try:
        text = path.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        continue
    suffix = path.suffix.lower()
    in_block_comment = ""
    for line_no, line in enumerate(text.splitlines(), 1):
        code, in_block_comment = strip_comment_only(line, suffix, in_block_comment)
        if not code:
            continue
        if suffix == ".gd" and re.search(r"\b(?:Builda|builda)\s*\.\s*ready\s*\(", code):
            errors.append(f"{rel.as_posix()}:{line_no}: old Builda SDK API found; replace old ready(...) with runtime_ready(...)")
        if suffix in {".js", ".ts", ".tsx", ".jsx", ".html"} and re.search(r"\b(?:Builda|builda)\s*\.\s*ready\s*\(", code):
            errors.append(f"{rel.as_posix()}:{line_no}: old Builda SDK API found; replace old Builda.ready(...) with Builda.runtime.ready(...)")
        for pattern, hint in patterns:
            if pattern.search(code):
                errors.append(f"{rel.as_posix()}:{line_no}: old Builda SDK API found; {hint}")

if errors:
    print("sdk-compat=failed")
    sys.stdout.flush()
    for error in errors:
        print(f"- {error}", file=sys.stderr)
    print("- Current SDK calls are async request/signal based. If the old code expected a direct return value, store the request id and handle the result in BuildaClient.builda.sdk_result; see addons/builda/examples/example.gd and scripts/BuildaClient.gd.", file=sys.stderr)
    raise SystemExit(1)

print("sdk-compat=ok")
PY
}

cmd_response_ok_or_exit() {
  local label="$1"
  local resp="$2"
  local code msg
  if command -v jq >/dev/null 2>&1; then
    code="$(printf '%s' "$resp" | jq -r '.code // 0')"
    msg="$(printf '%s' "$resp" | jq -r '.error // .msg // empty')"
  elif command -v python3 >/dev/null 2>&1; then
    code="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("code", 0))' <<<"$resp" 2>/dev/null || echo 0)"
    msg="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("error") or d.get("msg") or "")' <<<"$resp" 2>/dev/null || true)"
  else
    code="$(printf '%s' "$resp" | sed -n 's/.*"code"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
    msg="$(printf '%s' "$resp" | sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$code" ] || code=0
  fi
  if [ "$code" != "0" ]; then
    if [ "$code" = "200455" ]; then
      echo "发布失败：暂未开放外部游戏发布权限，请前往 $BUILDA_EARLY_ACCESS_URL 申请内测资格" >&2
      printf '%s\n' "$resp" >&2
      exit 1
    fi
    echo "$label failed: code=$code ${msg:-}" >&2
    if [ "$label" = "create draft" ] && printf '%s' "$msg" | grep -qi 'platform create error'; then
      echo "platform-create-error=1" >&2
      echo "Builda accepted the manifest shape, but the upstream platform game-create bridge failed. Do not repackage the build just for this error; retry after auth/platform status is fixed or report it to Builda." >&2
    fi
    printf '%s\n' "$resp" >&2
    exit 1
  fi
}

