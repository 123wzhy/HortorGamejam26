sdk_prepare_verified_archive() {
  local channel_path="$1" artifact_name="$2" meta version url expected_url expected_sha expected_size actual_sha actual_size
  need_python3
  mkdir -p "$PROJECT_STATE_DIR"
  SDK_TRANSACTION_ROOT="$(mktemp -d "$PROJECT_STATE_DIR/.sdk-install.XXXXXX")"
  SDK_ARCHIVE="$SDK_TRANSACTION_ROOT/$artifact_name"
  if ! meta="$(curl -fsS "$BUILDA_AGENT_BASE/agent/sdk/$channel_path")"; then
    rm -rf "$SDK_TRANSACTION_ROOT"
    echo "SDK metadata download failed." >&2
    return 1
  fi
  version="$(printf '%s' "$meta" | json_field version)"
  url="$(printf '%s' "$meta" | json_field url)"
  expected_sha="$(printf '%s' "$meta" | json_field sha256 | tr 'A-F' 'a-f')"
  expected_size="$(printf '%s' "$meta" | json_number size)"
  expected_url="$BUILDA_AGENT_BASE/agent/releases/$VERSION/$artifact_name"
  if [ "$version" != "$VERSION" ] || [ "$url" != "$expected_url" ] \
    || ! printf '%s' "$expected_sha" | grep -E '^[0-9a-f]{64}$' >/dev/null \
    || [ "${expected_size:-0}" -le 0 ]; then
    rm -rf "$SDK_TRANSACTION_ROOT"
    echo "SDK metadata invalid or does not match CLI version $VERSION." >&2
    return 1
  fi
  if ! curl -fsSL "$url" -o "$SDK_ARCHIVE"; then
    rm -rf "$SDK_TRANSACTION_ROOT"
    echo "SDK archive download failed." >&2
    return 1
  fi
  actual_size="$(wc -c < "$SDK_ARCHIVE" | tr -d '[:space:]')"
  actual_sha="$(python3 - "$SDK_ARCHIVE" <<'PY'
import hashlib
import sys
h = hashlib.sha256()
with open(sys.argv[1], "rb") as f:
    for block in iter(lambda: f.read(1024 * 1024), b""):
        h.update(block)
print(h.hexdigest())
PY
)"
  if [ "$actual_size" != "$expected_size" ] || [ "$actual_sha" != "$expected_sha" ]; then
    rm -rf "$SDK_TRANSACTION_ROOT"
    echo "SDK archive size or SHA-256 mismatch." >&2
    return 1
  fi
}

sdk_install_directory_set() {
  local transaction_root="$1"
  shift
  local backup_root="$transaction_root/backup" index=0 source destination backup failure=""
  local -a destinations=() backups=() had_old=() installed=()
  mkdir -p "$backup_root"
  while [ "$#" -gt 0 ]; do
    source="$1"
    destination="$2"
    shift 2
    [ -d "$source" ] || { failure="SDK staged directory missing: $source"; break; }
    mkdir -p "$(dirname "$destination")"
    backup="$backup_root/$index"
    destinations+=("$destination")
    backups+=("$backup")
    installed+=(0)
    if [ -e "$destination" ]; then
      had_old+=(1)
      if ! mv "$destination" "$backup"; then failure="failed to back up SDK directory: $destination"; break; fi
    else
      had_old+=(0)
    fi
    if ! mv "$source" "$destination"; then failure="failed to install SDK directory: $destination"; break; fi
    installed[$index]=1
    index=$((index + 1))
  done
  if [ -z "$failure" ]; then
    return 0
  fi

  local rollback_failed=0 i
  for ((i=${#destinations[@]}-1; i>=0; i--)); do
    if [ "${installed[$i]}" = 1 ] && [ -e "${destinations[$i]}" ]; then
      rm -rf "${destinations[$i]}" || rollback_failed=1
    fi
    if [ "${had_old[$i]}" = 1 ] && [ -e "${backups[$i]}" ]; then
      mv "${backups[$i]}" "${destinations[$i]}" || rollback_failed=1
    fi
  done
  if [ "$rollback_failed" = 1 ]; then
    echo "BUILDA_SDK_ROLLBACK_FAILED: backup=$backup_root original=$failure" >&2
  else
    rm -rf "$transaction_root"
    echo "$failure" >&2
  fi
  return 1
}

sdk_install() {
  # 引擎分流：godot 装 addon（现有全流程）；h5 装 web 内核到 .builda-agent/sdk/web/；
  # unity 装 C# 包装层 + WebGL 模板 + web 内核
  local engine
  engine="$(detect_engine_value .)"
  if [ "$engine" = "h5" ]; then
    sdk_install_web
    return
  fi
  if [ "$engine" = "unity" ]; then
    sdk_install_unity
    return
  fi
  [ -f project.godot ] || { echo "project.godot missing. Run inside a Godot project root, run: builda sdk init, or use an HTML5 (index.html/package.json at root) or Unity (ProjectSettings/ProjectVersion.txt) project." >&2; exit 1; }
  command -v unzip >/dev/null 2>&1 || { echo "Need unzip to install SDK addon." >&2; exit 1; }
  sdk_prepare_verified_archive "latest.json" "builda-sdk.zip" || exit 1
  local stage_root="$SDK_TRANSACTION_ROOT/stage" stage_addon
  mkdir -p "$stage_root"
  if ! unzip -q -o "$SDK_ARCHIVE" -d "$stage_root"; then rm -rf "$SDK_TRANSACTION_ROOT"; echo "Godot SDK zip invalid." >&2; exit 1; fi
  stage_addon="$stage_root/addons/builda"
  [ -f "$stage_addon/builda.gd" ] && [ -f "$stage_addon/plugin.cfg" ] || { rm -rf "$SDK_TRANSACTION_ROOT"; echo "Godot SDK zip layout invalid." >&2; exit 1; }
  # addons/builda/mic 归项目所有（BuildaMic 内置件是 L2 模板，CP 可魔改分析 worker）：
  # 升级不覆盖已存在的 mic/；恢复默认 = 删除该目录后重跑 sdk install
  if [ -d addons/builda/mic ]; then
    rm -rf "$stage_addon/mic"
    cp -R addons/builda/mic "$stage_addon/mic"
    echo "sdk-mic=preserved (addons/builda/mic is project-owned; delete it and rerun sdk install to reset to defaults)"
  fi
  sdk_install_directory_set "$SDK_TRANSACTION_ROOT" "$stage_addon" "addons/builda" || exit 1
  rm -rf "$SDK_TRANSACTION_ROOT"
  mkdir -p "$PROJECT_STATE_DIR"
  printf '%s\n' "$VERSION" > "$SDK_VERSION_FILE"
  echo "sdk-version=$VERSION"
  echo "sdk-installed=addons/builda"
  sdk_install_builda_client
  sdk_ensure_web_head_include
  if ! sdk_check; then
    echo "sdk-install=ok"
    echo "sdk-next=fix sdk check errors, then rerun: builda sdk check" >&2
    return 0
  fi
}

