  strip_agents_md_block "$LEGACY_AGENTS_BLOCK_BEGIN" "$LEGACY_AGENTS_BLOCK_END" || true
  if [ -f AGENTS.md ] && grep -qF "$AGENTS_BLOCK_BEGIN" AGENTS.md; then
