draft_idempotency_key() {
  local action="$1" game_id="$2" manifest_file="$3" existing_only="${4:-0}"
  mkdir -p "$ROOT"
  python3 - "$action" "$game_id" "$manifest_file" "$ROOT" "$existing_only" <<'PY'
import hashlib
import os
import re
import secrets
import sys
import time

action, game_id, path, root, existing_only = sys.argv[1:]
payload = hashlib.sha256()
with open(path, "rb") as manifest:
    for block in iter(lambda: manifest.read(1024 * 1024), b""):
        payload.update(block)
scope = "new" if not game_id else hashlib.sha256(game_id.encode("utf-8")).hexdigest()[:16]
payload_hex = payload.hexdigest()
fingerprint = hashlib.sha256(f"{action}\0{game_id}\0{payload_hex}".encode("utf-8")).hexdigest()
receipt = os.path.join(root, f"last-draft-operation-{fingerprint}")
prefix = f"draft-{action}-{scope}-{payload_hex}-"

if existing_only == "1":
    for _ in range(50):
        try:
            with open(receipt, "r", encoding="ascii") as saved:
                operation = saved.read().strip()
        except FileNotFoundError:
            raise SystemExit(0)
        except PermissionError:
            operation = ""
        if re.fullmatch(re.escape(prefix) + r"[0-9a-f]{32}", operation):
            print(operation)
            raise SystemExit(0)
        time.sleep(0.02)
    raise SystemExit(f"invalid or incomplete draft operation receipt: {receipt}; retry, or remove it if no publish is running")
try:
    fd = os.open(receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    operation = ""
    for _ in range(50):
        try:
            with open(receipt, "r", encoding="ascii") as saved:
                operation = saved.read().strip()
        except (FileNotFoundError, PermissionError):
            operation = ""
        if re.fullmatch(re.escape(prefix) + r"[0-9a-f]{32}", operation):
            break
        time.sleep(0.02)
    else:
        raise SystemExit(f"invalid or incomplete draft operation receipt: {receipt}; retry, or remove it if no publish is running")
else:
    operation = prefix + secrets.token_hex(16)
    with os.fdopen(fd, "w", encoding="ascii") as saved:
        saved.write(operation + "\n")
        saved.flush()
        os.fsync(saved.fileno())
print(operation)
PY
}

complete_draft_operation() {
  local operation_id="$1"
  python3 - "$operation_id" "$ROOT" <<'PY'
import glob
import os
import sys

operation, root = sys.argv[1:]
for receipt in glob.glob(os.path.join(root, "last-draft-operation-*")):
    try:
        with open(receipt, "r", encoding="ascii") as saved:
            matches = saved.read().strip() == operation
        if matches:
            os.remove(receipt)
            break
    except FileNotFoundError:
        continue
PY
}

uploader_platform() {
  local os_name arch_name
  os_name="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch_name="$(uname -m | tr '[:upper:]' '[:lower:]')"
  case "$os_name" in
    darwin) os_name=darwin ;;
    linux) os_name=linux ;;
    mingw*|msys*|cygwin*) os_name=windows ;;
    *) echo "Unsupported uploader OS: $os_name" >&2; return 1 ;;
  esac
  case "$arch_name" in
    x86_64|amd64) arch_name=amd64 ;;
    arm64|aarch64) arch_name=arm64 ;;
    *) echo "Unsupported uploader architecture: $arch_name" >&2; return 1 ;;
  esac
  case "$os_name-$arch_name" in
    darwin-amd64|darwin-arm64|linux-amd64|linux-arm64|windows-amd64|windows-arm64)
      printf '%s-%s' "$os_name" "$arch_name"
      ;;
    *)
      echo "Uploader Helper is not published for $os_name-$arch_name." >&2
      return 1
      ;;
  esac
}

install_uploader_helper() {
  local platform artifact sums expected directory binary tmp actual suffix=""
  platform="$(uploader_platform)"
  case "$platform" in windows-*) suffix=.exe ;; esac
  artifact="builda-uploader-${platform}${suffix}"
  sums="$(curl -fsS "$BUILDA_AGENT_BASE/agent/releases/$VERSION/SHA256SUMS")" || {
    echo "Failed to download uploader checksums." >&2
    return 1
  }
  expected="$(printf '%s\n' "$sums" | awk -v target="$artifact" '$2 == target {print $1; exit}')"
  if ! printf '%s' "$expected" | grep -Eq '^[0-9a-f]{64}$'; then
    echo "Uploader checksum is missing or invalid for $platform." >&2
    return 1
  fi
  directory="$ROOT/tools/$expected/$platform"
  binary="$directory/builda-uploader$suffix"
  if [ -f "$binary" ]; then
    actual="$(python3 - "$binary" <<'PY'
import hashlib, sys
h = hashlib.sha256()
with open(sys.argv[1], "rb") as f:
    for block in iter(lambda: f.read(1024 * 1024), b""):
        h.update(block)
print(h.hexdigest())
PY
)"
    if [ "$actual" = "$expected" ]; then
      printf '%s' "$binary"
      return 0
    fi
  fi
  mkdir -p "$directory"
  tmp="$directory/.download-$$"
  rm -f "$tmp"
  if ! curl -fsS "$BUILDA_AGENT_BASE/agent/releases/$VERSION/$artifact" -o "$tmp"; then
    rm -f "$tmp"
    echo "Failed to download uploader helper for $platform." >&2
    return 1
  fi
  actual="$(python3 - "$tmp" <<'PY'
import hashlib, sys
h = hashlib.sha256()
with open(sys.argv[1], "rb") as f:
    for block in iter(lambda: f.read(1024 * 1024), b""):
        h.update(block)
print(h.hexdigest())
PY
)"
  if [ "$actual" != "$expected" ]; then
    rm -f "$tmp"
    echo "Uploader helper checksum mismatch." >&2
    return 1
  fi
  chmod 700 "$tmp"
  mv -f "$tmp" "$binary"
  printf '%s' "$binary"
}

create_upload_session() {
  local zip="$1" engine="$2" game_id="$3" expected_size="$4" expected_sha="$5" idempotency="$6" studio_payload_hash="$7"
  local request_body
  request_body="$(python3 - "$engine" "$game_id" "$expected_size" "$expected_sha" "$idempotency" "$studio_payload_hash" <<'PY'
import json, sys
body = {
    "engine": sys.argv[1], "gameId": sys.argv[2], "expectedSize": int(sys.argv[3]),
    "expectedSha256": sys.argv[4], "idempotencyKey": sys.argv[5],
}
if sys.argv[6]:
    body["studioPayloadHash"] = sys.argv[6]
print(json.dumps(body, separators=(",", ":")))
PY
)"
  local -a request_args=(
    -X POST
    "$BUILDA_BASE/api/v1/uploads/build/sessions"
    -H "Idempotency-Key: $idempotency"
    -H 'Content-Type: application/json'
    --data-binary "$request_body"
  )
  if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
    request_args+=(
      -H "X-Builda-Studio-Publish-Id: $BUILDA_PUBLISH_OPERATION_ID"
      -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}"
      -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}"
    )
  fi
  authenticated_http_response "create upload session" "${request_args[@]}" || return $?
  SESSION_HTTP_STATUS="$AUTH_HTTP_STATUS"
  SESSION_BODY="$AUTH_HTTP_BODY"
}

legacy_upload_build() {
  local zip="$1" engine="$2"
  if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
    authenticated_http_request "upload build" -X POST "$BUILDA_BASE/api/v1/uploads/build" \
      -H "Idempotency-Key: $BUILDA_PUBLISH_OPERATION_ID" \
      -H "X-Builda-Studio-Publish-Id: $BUILDA_PUBLISH_OPERATION_ID" \
      -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}" \
      -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}" \
      -F "file=@$zip" -F "engine=$engine"
  else
    authenticated_http_request "upload build" -X POST "$BUILDA_BASE/api/v1/uploads/build" \
      -F "file=@$zip" -F "engine=$engine"
  fi
}

run_session_upload() {
  local zip="$1" engine="$2" game_id="$3" expected_size="$4" expected_sha="$5" idempotency="$6" studio_payload_hash="$7"
  local helper status
  create_upload_session "$zip" "$engine" "$game_id" "$expected_size" "$expected_sha" "$idempotency" "$studio_payload_hash"
  case "$SESSION_HTTP_STATUS" in
    200|201) ;;
    404|405)
      if [ "$expected_size" -le 209715200 ]; then
        echo "upload-session=unsupported; falling back to the legacy <=200MiB upload" >&2
        legacy_upload_build "$zip" "$engine"
        return
      fi
      echo "This server does not support resumable upload, and the bundle exceeds the legacy 200MiB limit." >&2
      return 1
      ;;
    *)
      echo "create upload session failed: HTTP $SESSION_HTTP_STATUS" >&2
      printf '%s\n' "$SESSION_BODY" >&2
      return 1
      ;;
  esac
  status="$(printf '%s' "$SESSION_BODY" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status", ""))')" || return 1
  if [ "$status" = "ready" ]; then
    printf '%s' "$SESSION_BODY" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["result"], ensure_ascii=False, separators=(",", ":")))'
    return
  fi
  case "$status" in
    created|uploading|uploaded|validating|promoting|retry_wait) ;;
    *)
      echo "Upload session cannot continue: status=$status" >&2
      printf '%s\n' "$SESSION_BODY" >&2
      return 1
      ;;
  esac
  helper="$(install_uploader_helper)"
  printf '%s' "$SESSION_BODY" | \
    BUILDA_UPLOAD_FILE="$zip" BUILDA_UPLOAD_ENGINE="$engine" \
    BUILDA_UPLOAD_OS="$(uploader_platform | cut -d- -f1)" \
    BUILDA_UPLOAD_ARCH="$(uploader_platform | cut -d- -f2)" \
    BUILDA_UPLOAD_AGENT_VERSION="$VERSION" \
    python3 -c 'import json,os,sys; session=json.load(sys.stdin); print(json.dumps({"schemaVersion":1,"file":os.environ["BUILDA_UPLOAD_FILE"],"agentVersion":os.environ["BUILDA_UPLOAD_AGENT_VERSION"],"helperVersion":os.environ["BUILDA_UPLOAD_AGENT_VERSION"],"os":os.environ["BUILDA_UPLOAD_OS"],"arch":os.environ["BUILDA_UPLOAD_ARCH"],"session":session}, separators=(",", ":")))' | \
    "$helper"
}

query_upload_session() {
  local session_id="$1" body_file status body
  [ -n "$session_id" ] || { echo "Usage: builda upload-status <session>" >&2; return 1; }
  body_file="$(mktemp)"
  local -a request_args=(
    -X POST
    "$BUILDA_BASE/api/v1/uploads/build/sessions/$session_id/inspect"
  )
  if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
    request_args+=(
      -H "Idempotency-Key: $BUILDA_PUBLISH_OPERATION_ID"
      -H "X-Builda-Studio-Publish-Id: $BUILDA_PUBLISH_OPERATION_ID"
      -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}"
      -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}"
    )
  fi
  authenticated_http_response "query upload session" "${request_args[@]}" || { rm -f "$body_file"; return 1; }
  status="$AUTH_HTTP_STATUS"
  body="$AUTH_HTTP_BODY"
  rm -f "$body_file"
  if [ "$status" != "200" ]; then
    echo "query upload session failed: HTTP $status" >&2
    printf '%s\n' "$body" >&2
    return 1
  fi
  printf '%s' "$body" | python3 -c 'import json,sys; d=json.load(sys.stdin); parts=d.get("parts") or []; out={k:d[k] for k in ("id","status","engine","expectedSize","effectiveLimitBytes","expiresAt","errorCode","errorMessage","result") if k in d}; out["uploadedBytes"]=sum(int(p.get("size",0)) for p in parts); print(json.dumps(out,ensure_ascii=False,separators=(",",":")))'
}

cancel_upload_session() {
  local session_id="${1:-}"
  [ -n "$session_id" ] || { echo "Usage: builda upload-cancel <session>" >&2; return 1; }
  local body_file status body
  body_file="$(mktemp)"
  local -a request_args=(
    -X POST
    "$BUILDA_BASE/api/v1/uploads/build/sessions/$session_id/cancel"
  )
  if [ -n "${BUILDA_PUBLISH_OPERATION_ID:-}" ]; then
    request_args+=(
      -H "Idempotency-Key: ${BUILDA_PUBLISH_OPERATION_ID}"
      -H "X-Builda-Studio-Publish-Id: ${BUILDA_PUBLISH_OPERATION_ID}"
      -H "X-Builda-Publish-Lease-Id: ${BUILDA_PUBLISH_LEASE_ID:?missing publish lease}"
      -H "X-Builda-Publish-Attempt: ${BUILDA_PUBLISH_ATTEMPT:?missing publish attempt}"
    )
  fi
  authenticated_http_response "cancel upload session" "${request_args[@]}" || { rm -f "$body_file"; return 1; }
  status="$AUTH_HTTP_STATUS"
  body="$AUTH_HTTP_BODY"
  rm -f "$body_file"
  if [ "$status" != "204" ]; then
    echo "cancel upload session failed: HTTP $status" >&2
    printf '%s\n' "$body" >&2
    return 1
  fi
}

