write_project_game() {
  local game_id="$1"
  local title="${2:-}"
  local version_id="${3:-}"
  [ -n "$game_id" ] || return 0
  mkdir -p "$(dirname "$PROJECT_FILE")"
  local updated_at
  updated_at="$(($(date +%s) * 1000))"
  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg provider "builda-h5" \
      --arg gameId "$game_id" \
