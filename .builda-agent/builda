assets_check_zip() {
  local zip="$1"
  [ -f "$zip" ] || { echo "assets.zip file required" >&2; exit 1; }
  need_python3
  python3 - "$zip" <<'PY'
import pathlib
import stat
import sys
import zipfile

zip_path = sys.argv[1]
audio_allowed = {".mp3", ".ogg", ".wav"}
res_allowed = {".glb", ".gltf", ".bin", ".ktx2", ".png", ".jpg", ".jpeg", ".webp", ".json", ".bundle", ".hash", ".pck"}
pck_count = 0
count = 0
total = 0
with zipfile.ZipFile(zip_path) as z:
    for info in z.infolist():
        name = info.filename
        if info.is_dir():
            continue
        pure = pathlib.PurePosixPath(name)
        parts = pure.parts
        if name.startswith("/") or "\\" in name or ":" in name or ".." in parts:
            raise SystemExit(f"Unsafe asset path: {name}")
        mode = (info.external_attr >> 16) & 0o170000
        if mode == stat.S_IFLNK:
            raise SystemExit(f"Symlink is forbidden: {name}")
        if not parts or parts[0] not in {"audio", "res"}:
            raise SystemExit(f"Asset must be under audio/ or res/: {name}")
        if parts[0] == "audio" and pure.suffix.lower() not in audio_allowed:
            raise SystemExit(f"Only .mp3/.ogg/.wav assets are allowed under audio/: {name}")
        if parts[0] == "res" and pure.suffix.lower() not in res_allowed:
            raise SystemExit(f"Only .glb/.gltf/.bin/.ktx2/.png/.jpg/.jpeg/.webp/.json/.bundle/.hash/.pck assets are allowed under res/: {name}")
        if pure.suffix.lower() == ".pck":
            pck_count += 1
        if any(part in {".godot", ".git", ".svn", ".hg", "__MACOSX"} for part in parts):
            raise SystemExit(f"Forbidden asset directory: {name}")
        if pure.name.startswith("."):
            raise SystemExit(f"Hidden files are forbidden: {name}")
        if info.file_size > 32 * 1024 * 1024:
            raise SystemExit(f"Asset file exceeds 32MB: {name}")
        count += 1
        total += info.file_size
        if count > 500:
            raise SystemExit("Too many asset files: max 500")
        if total > 320 * 1024 * 1024:
            raise SystemExit("Assets zip exceeds 320MB uncompressed")
if count == 0:
    raise SystemExit("assets.zip is empty")
print("assets=ok")
print(f"assets-files={count}")
print(f"assets-bytes={total}")
if pck_count:
    print(f"assets-pck={pck_count}")
    print("assets-pck-note=服务端会深度校验 pck 必须 data-only：不含 .gd/.gdc/.gdns/.cs 等脚本、原生库、加密内容，场景/资源不得引用脚本；含脚本的 pck 会在上传时整包被拒。")
PY
}

assets_upload() {
  need_token
  local zip="$1"
  [ -n "$zip" ] || { echo "Usage: builda assets upload <zip>" >&2; exit 1; }
  assets_check_zip "$zip" >/dev/null
  local game_id
  game_id="$(project_game_id)"
  if [ -n "$game_id" ]; then
    resp="$(authenticated_http_request "assets upload" -X POST "$BUILDA_BASE/api/v1/uploads/assets" -F "file=@$zip" -F "gameId=$game_id")"
  else
    resp="$(authenticated_http_request "assets upload" -X POST "$BUILDA_BASE/api/v1/uploads/assets" -F "file=@$zip")"
  fi
  printf '%s\n' "$resp" > "$ROOT/last-assets.json"
  echo "$resp"
  if command -v jq >/dev/null 2>&1; then
    if [ ! -f "$MANIFEST" ]; then "$0" new-manifest >/dev/null; fi
    tmp="$(mktemp)"
    jq \
      --arg v "$(printf '%s' "$resp" | jq -r '.assetsVersion // empty')" \
      --arg base "$(printf '%s' "$resp" | jq -r '.assetsBaseUrl // empty')" \
      --arg manifest "$(printf '%s' "$resp" | jq -r '.assetsManifestUrl // empty')" \
      '.assetsVersion=$v | .assetsBaseUrl=$base | .assetsManifestUrl=$manifest' "$MANIFEST" > "$tmp"
    mv "$tmp" "$MANIFEST"
    echo "Updated $MANIFEST with audio assets fields."
  elif command -v python3 >/dev/null 2>&1; then
    if [ ! -f "$MANIFEST" ]; then "$0" new-manifest >/dev/null; fi
    python3 - "$MANIFEST" "$resp" <<'PY'
import json
import sys
manifest_path, resp_raw = sys.argv[1:3]
with open(manifest_path, "r", encoding="utf-8") as f:
    m = json.load(f)
r = json.loads(resp_raw)
m["assetsVersion"] = r.get("assetsVersion", "")
m["assetsBaseUrl"] = r.get("assetsBaseUrl", "")
m["assetsManifestUrl"] = r.get("assetsManifestUrl", "")
with open(manifest_path, "w", encoding="utf-8") as f:
    json.dump(m, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
    echo "Updated $MANIFEST with audio assets fields."
  else
    echo "Assets uploaded. Copy assetsVersion/assetsBaseUrl/assetsManifestUrl into $MANIFEST."
  fi
}

