    [ -s AGENTS.md ] && printf '\n'
    printf '%s\n' "$AGENTS_BLOCK_BEGIN"
    printf '%s\n\n' "## BuildaGame 发布工具（项目级）"
    stub_body
    printf '%s\n' "$AGENTS_BLOCK_END"
