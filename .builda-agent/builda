legacy_auth_migrate() {
  # 凭证目录改名迁移：复制不删除——旧 CLI（其他项目里尚未自更新的）仍读旧目录。
  # uninstall --purge 会两代一起清；BUILDA_AUTH_DIR 显式覆盖时不迁移。
  [ -n "${BUILDA_AUTH_DIR:-}" ] && return 0
