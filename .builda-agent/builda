bundle_check() {
  local webview_compat="${BUILDA_WEBVIEW_COMPAT:-0}" zip="" engine=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --webview-compatible)
        webview_compat="1"
        shift
        ;;
      --engine)
        engine="${2:-}"
        shift 2
        ;;
      --engine=*)
        engine="${1#--engine=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Unknown bundle-check option: $1" >&2
        echo "Usage: builda bundle-check [--engine godot|h5|unity] [--webview-compatible] <zip>" >&2
        exit 1
        ;;
      *)
        zip="$1"
        shift
        break
        ;;
    esac
  done
  [ -n "$zip" ] || zip="${1:-}"
  [ -f "$zip" ] || { echo "zip file required" >&2; exit 1; }
  [ -n "$engine" ] || engine="$(manifest_engine "$MANIFEST")"
  case "$engine" in
    godot|h5|unity) ;;
    *) echo "bundle-check engine must be godot, h5 or unity: $engine" >&2; exit 1 ;;
  esac
  need_python3
  # 校验口径与后端 buildzip 一致（单一真相源：h5_bundle_spec.md 附表 B）：
  # godot = 三件套 + Godot 黑名单 + threads/COI/wasm 内存；h5 = 仅入口 + 通用黑名单 +
  # sourcemap/node_modules 禁用，跳过 Godot 专属正则；unity = Build/ 四件套（后缀匹配，
  # 允许 .unityweb）+ Unity 工程黑名单 + StreamingAssets 扩展名豁免，禁用规则同 h5。
  python3 - "$zip" "$webview_compat" "$engine" <<'PY'
import pathlib
import re
import stat
import sys
import zipfile

zip_path = sys.argv[1]
webview_compat = sys.argv[2] == "1"
engine = sys.argv[3]
max_wasm_memory = 1 << 30
required = {"index.html", "index.js", "index.wasm", "index.pck"} if engine == "godot" else {"index.html"}
# 扩展名白名单：与后端 buildzip godot/h5/unity 集合一致（h5_bundle_spec.md 附表 B，三处同步改）
godot_ext = {
    ".html", ".js", ".wasm", ".pck",
    ".png", ".jpg", ".jpeg", ".webp", ".svg",
    ".ico", ".json", ".css", ".txt", ".md",
}
h5_ext = godot_ext | {
    ".mjs", ".woff", ".woff2", ".ttf", ".otf",
    ".mp3", ".ogg", ".wav", ".m4a", ".mp4", ".webm",
    ".avif", ".gif", ".bin", ".dat",
    ".glsl", ".frag", ".vert", ".atlas", ".fnt",
    ".xml", ".gltf", ".glb", ".ktx2", ".basis",
}
unity_ext = h5_ext | {".unityweb", ".data"}
allowed_ext = {"godot": godot_ext, "h5": h5_ext, "unity": unity_ext}[engine]
# unity 的 Build/ 四件套（文件名带构建名变量，只做前缀+后缀匹配，附表 B.7）
unity_found = {"loader.js": False, "framework.js": False, "wasm": False, "data": False}
found = set()
forbidden = []
bad_ext = []
sdk_found = False
index_html = ""
index_js = ""
wasm_size = 0

def clean_name(name: str) -> str:
    clean = name[2:] if name.startswith("./") else name
    clean = clean.rstrip("/")
    pure = pathlib.PurePosixPath(clean)
    if name.startswith("/") or "\\" in name or ":" in name or ".." in pure.parts:
        raise SystemExit(f"Unsafe zip path: {name}")
    return clean

with zipfile.ZipFile(zip_path) as z:
    infos = z.infolist()
    if len(infos) > 1000:
        raise SystemExit("Too many ZIP entries: max 1000 (files and directories)")
    has_index_js = False
    file_count = 0
    total_uncompressed = 0
    for info in infos:
        if info.is_dir():
            continue
        file_count += 1
        if file_count > 500:
            raise SystemExit("Too many bundle files: max 500")
        if info.file_size > 768 * 1024 * 1024:
            raise SystemExit(f"Bundle file exceeds 768MiB uncompressed: {info.filename}")
        total_uncompressed += info.file_size
        if total_uncompressed > 1024 * 1024 * 1024:
            raise SystemExit("Bundle exceeds 1GiB total uncompressed size")
        clean = clean_name(info.filename)
        mode = (info.external_attr >> 16) & 0o170000
        if mode == stat.S_IFLNK:
            raise SystemExit(f"Symlink is forbidden: {clean}")
        parts = pathlib.PurePosixPath(clean).parts
        name = pathlib.PurePosixPath(clean).name
        suffix = pathlib.PurePosixPath(clean).suffix.lower()
        if clean in required:
            found.add(clean)
        if clean == "index.js":
            has_index_js = True
        if clean in {"addons/builda/web/builda-sdk.js", "builda-sdk.js"}:
            sdk_found = True
        if suffix == ".wasm":
            wasm_size = max(wasm_size, info.file_size)
        if clean == "addons/builda/web/builda-sdk.d.ts" or name.endswith(".d.ts") or name == "builda-dev-shell.html":
            forbidden.append(clean)
        if name in {"project.godot", "export_presets.cfg", ".env"} or name.endswith(".import"):
            forbidden.append(clean)
        if any(part in {".godot", ".git", ".svn", ".hg", "__MACOSX"} for part in parts):
            forbidden.append(clean)
        if engine != "godot":
            if name.endswith(".map"):
                forbidden.append(clean + " (sourcemap leaks sources; disable sourcemaps and rebuild)")
            if "node_modules" in parts:
                forbidden.append(clean + " (node_modules must not be zipped)")
        if engine == "unity":
            if name.endswith((".meta", ".csproj", ".sln", ".unity")):
                forbidden.append(clean + " (Unity project/editor files must not be zipped)")
            if any(part in {"Library", "Temp", "Obj", "ProjectSettings"} for part in parts):
                forbidden.append(clean + " (Unity project directories must not be zipped)")
            if clean.startswith("Build/"):
                if clean.endswith(".loader.js"):
                    unity_found["loader.js"] = True
                elif clean.endswith((".framework.js", ".framework.js.unityweb")):
                    unity_found["framework.js"] = True
                elif clean.endswith((".wasm", ".wasm.unityweb")):
                    unity_found["wasm"] = True
                elif clean.endswith((".data", ".data.unityweb")):
                    unity_found["data"] = True
        # unity 的 StreamingAssets/ 跳过扩展名白名单（AssetBundle 惯例常无扩展名，附表 B.3）；
        # 禁用清单/符号链接/zip slip 照常执行
        streaming_exempt = engine == "unity" and clean.startswith("StreamingAssets/")
        if not streaming_exempt and suffix not in allowed_ext:
            bad_ext.append(clean)
    missing = sorted(required - found)
    if missing:
        raise SystemExit("Missing root " + ", ".join(missing))
    if engine == "unity":
        missing_unity = sorted(k for k, ok in unity_found.items() if not ok)
        if missing_unity:
            raise SystemExit("Missing Build/ Unity WebGL artifacts (*." + ", *.".join(missing_unity) + "; .unityweb suffix allowed). Re-export with the default Build/ output layout.")
    if forbidden:
        raise SystemExit("Forbidden project/editor files: " + ", ".join(forbidden))
    if bad_ext:
        raise SystemExit("File types not allowed for engine=" + engine + ": " + ", ".join(bad_ext))
    if sdk_found:
        # 旧形态（SDK 焊在包内）继续放行；新形态 zip 不含 SDK，由宿主按 manifest sdk 版本注入
        print("bundle-sdk=embedded (legacy form; new exports ship without SDK, host injects by manifest)")
    with z.open("index.html") as f:
        index_html = f.read(1024 * 1024).decode("utf-8", "ignore")
    if engine == "godot" and has_index_js:
        with z.open("index.js") as f:
            index_js = f.read(4 * 1024 * 1024).decode("utf-8", "ignore")

if "builda-sdk.js" not in index_html:
    if engine == "godot":
        raise SystemExit("index.html does not load builda-sdk.js. Ensure Godot Web export head include injects the SDK script.")
    if engine == "unity":
        raise SystemExit('index.html does not load builda-sdk.js. Select the Builda WebGL Template (Player Settings -> Resolution and Presentation; installed by builda sdk install), or add <script src="builda-sdk.js"></script> to your custom template head, then rebuild.')
    raise SystemExit('index.html does not load builda-sdk.js. Add <script src="builda-sdk.js"></script> to the HTML head and rebuild.')
if wasm_size > max_wasm_memory:
    raise SystemExit(f"wasm file exceeds 1GiB: {wasm_size} bytes")

print("bundle=ok")
print("bundle-engine=" + engine)
print("sdk-injected=ok")

if engine == "godot":
    # Godot 专属：threads/COI 导出模板变量与 Emscripten 内存正则（h5 跳过，误报不可控）
    threads_enabled = bool(re.search(r"\bGODOT_THREADS_ENABLED\s*=\s*true\b", index_html) or re.search(r"\bGODOT_THREADS_ENABLED\s*=\s*true\b", index_js))
    coi_enabled = bool(re.search(r"\bensureCrossOriginIsolationHeaders\s*:\s*true\b", index_html) or re.search(r"\bensureCrossOriginIsolationHeaders\s*:\s*true\b", index_js))
    if webview_compat:
        if threads_enabled:
            raise SystemExit("Godot Web export has threads enabled. For WebView compatibility mode, set variant/thread_support=false and re-export.")
        if coi_enabled:
            raise SystemExit("Godot Web export requests cross-origin isolation headers. For WebView compatibility mode, set progressive_web_app/ensure_cross_origin_isolation_headers=false and re-export.")

    checks = [
        (r"\bINITIAL_MEMORY\b\s*[:=]\s*(\d+)", "INITIAL_MEMORY", "bytes"),
        (r"\binitialMemory\b\s*[:=]\s*(\d+)", "initialMemory", "bytes"),
        (r"\bwasmMemory\b\s*[:=]\s*(\d+)", "wasmMemory", "bytes"),
        (r"WebAssembly\.Memory\s*\(\s*\{[^}]*\binitial\b\s*:\s*(\d+)", "WebAssembly.Memory.initial", "pages"),
    ]
    detected = []
    for pattern, label, unit in checks:
        for raw in re.findall(pattern, index_js):
            value = int(raw)
            bytes_value = value * 65536 if unit == "pages" else value
            detected.append((label, bytes_value))
            if bytes_value > max_wasm_memory:
                raise SystemExit(f"WASM memory exceeds 1GiB: {label}={bytes_value} bytes")

    print("threads-check=" + ("webview-compatible" if webview_compat else "default-allowed"))
    if detected:
        print("wasm-memory-check=ok")
    else:
        print("wasm-memory-check=unknown")
        print("wasm-memory-hint=No explicit WebAssembly memory setting was found in index.js; upload will still enforce the 1GiB bundle/runtime limit.")
PY
  # 非阻断提示：zip 超 50MiB 建议做包体优化；只提示、不改变服务端动态上传上限。
  local zip_bytes
  zip_bytes=$(wc -c < "$zip" | tr -d '[:space:]')
  echo "bundle-zip-bytes=$zip_bytes"
  if [ "$zip_bytes" -gt 52428800 ]; then
    echo "bundle-size-hint=zip 已达 $((zip_bytes / 1048576))MiB（>50MiB）。必须评估分包/资源外置优化；建议阅读 $BUILDA_AGENT_BASE/agent/releases/$VERSION/md_bundle_size.md（大资源外置 res/**、音频/字体/纹理瘦身）。该提示不阻断上传。" >&2
  fi
}

builda_dev_parse() {
  local web="" port="18088" game_id="local-game" safearea="" assets=""
  local mode="${1:-serve}"
  if [ "$mode" = "e2e" ]; then
    echo "dev-e2e=removed" >&2
    echo "builda dev e2e 已移除：它只重复断言 SDK 内置 mock 行为。改用 builda dev 起本地运行器，在浏览器里跑真实游戏验证。" >&2
    exit 1
  fi
  if [ "$mode" = "serve" ]; then
    shift || true
  else
    mode="serve"
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --web)
        web="${2:-}"
        shift 2
        ;;
      --web=*)
        web="${1#--web=}"
        shift
        ;;
      --port)
        port="${2:-}"
        shift 2
        ;;
      --port=*)
        port="${1#--port=}"
        shift
        ;;
      --game-id)
        game_id="${2:-}"
        shift 2
        ;;
      --game-id=*)
        game_id="${1#--game-id=}"
        shift
        ;;
      --safearea)
        safearea="${2:-}"
        shift 2
        ;;
      --safearea=*)
        safearea="${1#--safearea=}"
        shift
        ;;
      --assets)
        assets="${2:-}"
        shift 2
        ;;
      --assets=*)
        assets="${1#--assets=}"
        shift
        ;;
      ""|-h|--help|help)
        echo "Usage: builda dev --web <dir|zip> [--assets <dir|zip>] [--port 18088] [--game-id local-game] [--safearea 44,0,34,0]"
        return 0
        ;;
      *)
        echo "Unknown dev arg: $1" >&2
        echo "Usage: builda dev --web <dir|zip> [--assets <dir|zip>] [--port 18088] [--game-id local-game] [--safearea 44,0,34,0]" >&2
        exit 1
        ;;
    esac
  done
  [ -n "$web" ] || { echo "Usage: builda dev --web <dir|zip> [--port 18088]" >&2; exit 1; }
  [ -e "$web" ] || { echo "dev web path not found: $web" >&2; exit 1; }
  # assets 兜底源：未显式指定时探测项目根 ./assets（audio|res 顶层子树，与 assets.zip 同布局）
  if [ -z "$assets" ] && { [ -d "assets/audio" ] || [ -d "assets/res" ]; }; then
    assets="assets"
  fi
  if [ -n "$assets" ] && [ ! -e "$assets" ]; then
    echo "dev assets path not found: $assets" >&2
    exit 1
  fi
  builda_dev_serve "$web" "$port" "$game_id" "$safearea" "$assets"
}

builda_dev_serve() {
  local web="$1" port="$2" game_id="$3" safearea="${4:-}" assets="${5:-}"
  need_python3
  BUILDA_DEV_STATE_DIR="$PROJECT_STATE_DIR" python3 - "$web" "$port" "$game_id" "$safearea" "$assets" <<'PY'
import mimetypes
import os
import pathlib
import posixpath
import shutil
import sys
import tempfile
import urllib.parse
import zipfile
from functools import partial
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

source = pathlib.Path(sys.argv[1]).expanduser().resolve()
state_dir = os.environ.get("BUILDA_DEV_STATE_DIR") or ".builda-agent"
try:
    port = int(sys.argv[2])
except ValueError:
    raise SystemExit("dev port must be an integer")
game_id = sys.argv[3] or "local-game"
safe_area = sys.argv[4] if len(sys.argv) > 4 else ""
assets_arg = sys.argv[5] if len(sys.argv) > 5 else ""
def _csv4_ok(value: str) -> bool:
    parts = value.split(",")
    if len(parts) != 4:
        return False
    try:
        return all(float(p) >= 0 for p in parts)
    except ValueError:
        return False
if safe_area and not _csv4_ok(safe_area):
    raise SystemExit("dev --safearea must be top,right,bottom,left in CSS px, e.g. 44,0,34,0")
if port < 0 or port > 65535:
    raise SystemExit("dev port must be between 0 and 65535")

temp_dirs = []
web_root = source

def safe_extract(zip_path: pathlib.Path, prefix: str = "builda-dev-web-") -> pathlib.Path:
    td = tempfile.TemporaryDirectory(prefix=prefix)
    temp_dirs.append(td)
    dst = pathlib.Path(td.name)
    with zipfile.ZipFile(zip_path) as zf:
        for info in zf.infolist():
            name = info.filename
            pure = pathlib.PurePosixPath(name)
            if name.startswith("/") or "\\" in name or ":" in name or ".." in pure.parts:
                raise SystemExit(f"Unsafe zip path: {name}")
            if info.is_dir():
                continue
            target = dst / pathlib.Path(*pure.parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            with zf.open(info) as src, target.open("wb") as out:
                shutil.copyfileobj(src, out)
    return dst

if source.is_file():
    if source.suffix.lower() != ".zip":
        raise SystemExit("dev --web file must be a .zip H5 bundle")
    web_root = safe_extract(source)
elif not source.is_dir():
    raise SystemExit("dev --web must be a directory or zip")

index = web_root / "index.html"
if not index.is_file():
    raise SystemExit(f"dev web root missing index.html: {web_root}")

# assets 兜底源（audio/**、res/**，与 assets.zip 同布局）：CP 不用再把资源拷进构建目录，
# mock SDK 按页面目录解析出的 /audio/... /res/... 请求在 web root 缺文件时由这里补上
assets_root = None
if assets_arg:
    assets_source = pathlib.Path(assets_arg).expanduser().resolve()
    if assets_source.is_file():
        if assets_source.suffix.lower() != ".zip":
            raise SystemExit("dev --assets file must be a .zip assets bundle")
        assets_root = safe_extract(assets_source, prefix="builda-dev-assets-")
    elif assets_source.is_dir():
        assets_root = assets_source
    else:
        raise SystemExit(f"dev --assets must be a directory or zip: {assets_source}")

# mock SDK 兜底查找顺序：web 导出目录 → Godot addon（addons/builda/web/）→
# HTML5/Unity 工具链落点（<state_dir>/sdk/web/）
def first_file(*candidates):
    for c in candidates:
        if c.is_file():
            return c
    return None

project_sdk_js = first_file(
    pathlib.Path.cwd() / "addons" / "builda" / "web" / "builda-sdk.js",
    pathlib.Path.cwd() / state_dir / "sdk" / "web" / "builda-sdk.js",
)
sdk_present = (web_root / "addons" / "builda" / "web" / "builda-sdk.js").is_file() or (web_root / "builda-sdk.js").is_file() or project_sdk_js is not None
# 测试外壳随 mock SDK 装进项目，web 导出里不会有；从项目目录兜底 serve
project_shell = first_file(
    pathlib.Path.cwd() / "addons" / "builda" / "web" / "builda-dev-shell.html",
    pathlib.Path.cwd() / state_dir / "sdk" / "web" / "builda-dev-shell.html",
)
shell_present = (web_root / "builda-dev-shell.html").is_file() or project_shell is not None
# BuildaMic 分析 worker 同理从项目目录兜底；正式打包必须随 zip 分发
project_mic_worker = first_file(
    pathlib.Path.cwd() / "addons" / "builda" / "mic" / "web" / "builda-mic-worker.js",
    pathlib.Path.cwd() / state_dir / "sdk" / "web" / "mic" / "builda-mic-worker.js",
)
mic_worker_in_project = project_mic_worker is not None
mic_worker_in_web = (web_root / "addons" / "builda" / "mic" / "web" / "builda-mic-worker.js").is_file()

mimetypes.add_type("application/wasm", ".wasm")
mimetypes.add_type("application/octet-stream", ".pck")
mimetypes.add_type("text/javascript", ".js")
mimetypes.add_type("audio/ogg", ".ogg")
mimetypes.add_type("model/gltf-binary", ".glb")
mimetypes.add_type("image/ktx2", ".ktx2")

def entry_query() -> str:
    query = {"gameId": game_id}
    if safe_area:
        query["builda_mock_safearea"] = safe_area
    return urllib.parse.urlencode(query)

entry_path = f"/index.html?{entry_query()}"
shell_path = f"/builda-dev-shell.html?{entry_query()}"

class DevHandler(SimpleHTTPRequestHandler):
    server_version = "BuildaDev/1"

    def end_headers(self):
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Cross-Origin-Embedder-Policy", "require-corp")
        self.send_header("Cross-Origin-Resource-Policy", "cross-origin")
        super().end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = posixpath.normpath(urllib.parse.unquote(parsed.path))
        if path in ("/builda-sdk.js", "/addons/builda/web/builda-sdk.js"):
            target = pathlib.Path(self.directory) / path.lstrip("/")
            if not target.is_file() and project_sdk_js is not None:
                data = project_sdk_js.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", "text/javascript")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if path.startswith("/addons/builda/mic/web/") or path == "/mic/builda-mic-worker.js":
            # BuildaMic worker 兜底：web 导出目录没有时，从项目目录/工具链目录 serve（路径已 normpath 去 ..）
            target = pathlib.Path(self.directory) / path.lstrip("/")
            candidate = first_file(
                pathlib.Path.cwd() / path.lstrip("/"),
                project_mic_worker if project_mic_worker is not None else pathlib.Path("/nonexistent"),
            )
            if not target.is_file() and candidate is not None:
                data = candidate.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if assets_root is not None and (path.startswith("/audio/") or path.startswith("/res/")):
            # assets 兜底：web root 没有该文件时从项目 assets 源伺服（路径已 normpath 去 ..）
            target = pathlib.Path(self.directory) / path.lstrip("/")
            candidate = assets_root / path.lstrip("/")
            if not target.is_file() and candidate.is_file():
                data = candidate.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if path == "/builda-dev-shell.html":
            target = pathlib.Path(self.directory) / "builda-dev-shell.html"
            if not target.is_file() and project_shell is not None:
                data = project_shell.read_bytes()
                self.send_response(HTTPStatus.OK)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        if path in ("", "/"):
            self.send_response(HTTPStatus.FOUND)
            self.send_header("Location", shell_path if shell_present else entry_path)
            self.end_headers()
            return
        super().do_GET()

def make_server(start_port: int):
    candidates = [0] if start_port == 0 else range(start_port, min(start_port + 21, 65536))
    last_error = None
    handler = partial(DevHandler, directory=str(web_root))
    for candidate in candidates:
        try:
            return ThreadingHTTPServer(("127.0.0.1", candidate), handler)
        except OSError as exc:
            last_error = exc
    raise SystemExit(f"could not bind localhost port {start_port}: {last_error}")

httpd = make_server(port)
actual_port = httpd.server_address[1]
base = f"http://127.0.0.1:{actual_port}"
print("dev=ok", flush=True)
print(f"dev-url={base}{shell_path if shell_present else entry_path}", flush=True)
print(f"game-url={base}{entry_path}", flush=True)
print("sdk-mode=local-mock", flush=True)
print(f"dev-shell={'present' if shell_present else 'missing'}", flush=True)
print(f"dev-sdk={'present' if sdk_present else 'missing'}", flush=True)
print(f"dev-web={web_root}", flush=True)
if assets_root is not None:
    print(f"dev-assets={assets_root} (audio/**, res/** served as a same-origin fallback; keep them out of the build dir and the bundle zip)", flush=True)
else:
    print("dev-assets=none (games using Builda.audio.* / assets.url(): pass --assets <dir|zip> or keep audio/, res/ under ./assets/ at the project root)", flush=True)
print("dev-mock-player=local-player (append &builda_mock_player=<id>&builda_mock_name=<name> to the URL to switch identity)", flush=True)
if not shell_present:
    print("dev-shell-warning=builda-dev-shell.html not found; run sdk install to get the test shell (orientation/notch/capsule/pay/ad mock).", flush=True)
if not sdk_present:
    print("dev-warning=builda-sdk.js not found in web root or project; run sdk install (dev server serves the project copy automatically).", flush=True)
if mic_worker_in_project and not mic_worker_in_web:
    print("dev-mic=served-from-project (games using BuildaMic must copy addons/builda/mic/web/ into the export dir before zipping; dev server only covers local runs)", flush=True)
try:
    httpd.serve_forever()
except KeyboardInterrupt:
    print("dev=stopped reason=interrupt", flush=True)
finally:
    httpd.server_close()
    for td in temp_dirs:
        td.cleanup()
PY
}

manifest_string_field() {
  local file="$1" field="$2"
  [ -f "$file" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r ".$field // empty" "$file"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$field" <<'PY'
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
print(data.get(sys.argv[2], "") or "")
PY
  else
    sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$file" | head -1
